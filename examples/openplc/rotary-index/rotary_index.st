(* ------------------------------------------------------------------------
   FactoryForge starter -- Rotary index station (scene rotary-index)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     With the deck home, the rod back and deck_eye clear, drop a carton on
     the deck (emitter.emit), let it settle for the pot's seconds, and turn
     the deck a quarter (table.index). When table.atindex is made, sweep
     the carton onto the running outfeed with the cylinder -- two coils,
     two reeds -- and only once pusher.retracted is made turn the deck home
     again. The deck has no rollers: the only way on is the emitter and the
     only way off is the pusher.

   DONE WHEN
     Every carton leaves the deck turned a quarter and done.count climbs
     one per cycle. Then slow the deck (the turntable's Index Speed) and
     nothing changes but the cycle time: a push timed on the rated quarter
     turn meets the carton half way round. Turn the deck home the moment
     pusher.extended drops and the rod is still out over it -- between its
     two reeds a cylinder is neither extended nor retracted. Seize the deck
     (table.fault) mid-turn and neither limit switch is made.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open:

       factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               emitter.emit
     0x1      1     %QX100.1               outfeed.rotate
     0x2      1     %QX100.2               panel.green
     0x3      1     %QX100.3               panel.red
     0x4      1     %QX100.4               pusher.extend
     0x5      1     %QX100.5               pusher.retract
     0x6      1     %QX100.6               table.index
     0x7      1     %QX100.7               tower.green
     0x8      1     %QX101.0               tower.red
     0x9      1     %QX101.1               tower.yellow
     1x0      1     %IX100.0               deck_eye.detect
     1x1      1     %IX100.1               outfeed.fault
     1x2      1     %IX100.2               panel.estop
     1x3      1     %IX100.3               panel.reset
     1x4      1     %IX100.4               panel.start
     1x5      1     %IX100.5               panel.stop
     1x6      1     %IX100.6               pusher.extended
     1x7      1     %IX100.7               pusher.fault
     1x8      1     %IX101.0               pusher.retracted
     1x9      1     %IX101.1               table.athome
     1x10     1     %IX101.2               table.atindex
     1x11     1     %IX101.3               table.fault
     3x0      2     %IW100 + %IW101        done.count
     3x2      2     %IW102 + %IW103        panel.setpoint
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

PROGRAM rotary_index
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    EmitterEmit   AT %QX100.0  : BOOL;  (* emitter.emit   0x0   rising edge = feed one carton; hold each level well over one poll *)
    OutfeedRotate AT %QX100.1  : BOOL;  (* outfeed.rotate 0x1   run the belt *)
    PanelGreen    AT %QX100.2  : BOOL;  (* panel.green    0x2   green lamp on the panel *)
    PanelRed      AT %QX100.3  : BOOL;  (* panel.red      0x3   red lamp on the panel *)
    PusherExtend  AT %QX100.4  : BOOL;  (* pusher.extend  0x4   extend coil (5/2 valve, no spring: the rod stays where it was last driven) *)
    PusherRetract AT %QX100.5  : BOOL;  (* pusher.retract 0x5   retract coil *)
    TableIndex    AT %QX100.6  : BOOL;  (* table.index    0x6   turn the deck to its index angle; FALSE turns it home *)
    TowerGreen    AT %QX100.7  : BOOL;  (* tower.green    0x7   tower lamp, green *)
    TowerRed      AT %QX101.0  : BOOL;  (* tower.red      0x8   tower lamp, red *)
    TowerYellow   AT %QX101.1  : BOOL;  (* tower.yellow   0x9   tower lamp, yellow *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    DeckEyeDetect   AT %IX100.0  : BOOL;  (* deck_eye.detect  1x0   TRUE while anything breaks the beam to the reflector *)
    OutfeedFault    AT %IX100.1  : BOOL;  (* outfeed.fault    1x1   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    PanelEstop      AT %IX100.2  : BOOL;  (* panel.estop      1x2   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset      AT %IX100.3  : BOOL;  (* panel.reset      1x3   Reset button, momentary: a short pulse per press *)
    PanelStart      AT %IX100.4  : BOOL;  (* panel.start      1x4   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop       AT %IX100.5  : BOOL;  (* panel.stop       1x5   Stop button, momentary: a short pulse per press *)
    PusherExtended  AT %IX100.6  : BOOL;  (* pusher.extended  1x6   reed switch at full stroke *)
    PusherFault     AT %IX100.7  : BOOL;  (* pusher.fault     1x7   TRUE = the cylinder has seized *)
    PusherRetracted AT %IX101.0  : BOOL;  (* pusher.retracted 1x8   reed switch at home; mid-stroke neither reed is made *)
    TableAthome     AT %IX101.1  : BOOL;  (* table.athome     1x9   deck square at home *)
    TableAtindex    AT %IX101.2  : BOOL;  (* table.atindex    1x10  deck square at its 90 deg index; between the two neither is made *)
    TableFault      AT %IX101.3  : BOOL;  (* table.fault      1x11  TRUE = the deck has seized where it is *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    DoneCountHi     AT %IW100    : WORD;  (* done.count     3x0   high word of DoneCount *)
    DoneCountLo     AT %IW101    : WORD;  (* done.count     3x1   low word of DoneCount *)
    PanelSetpointHi AT %IW102    : WORD;  (* panel.setpoint 3x2   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW103    : WORD;  (* panel.setpoint 3x3   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    DoneCount     : DINT;  (* done.count     cartons this remover has taken off the line, running total *)
    PanelSetpoint : REAL;  (* panel.setpoint the operator's pot, 0.5..3 s (starts at 1) *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  DoneCount := FF_WORDS_TO_DINT(HI := DoneCountHi, LO := DoneCountLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through DoneCount, PanelSetpoint. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  (* none in this scene *)

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : rotary_index;
  END_RESOURCE

END_CONFIGURATION
