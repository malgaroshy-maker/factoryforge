(* ------------------------------------------------------------------------
   FactoryForge starter -- Light curtain sorting (scene light-curtain-sorting)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Sort on a measurement rather than on two bits. The curtain reports how
     tall each carton is, in metres, so the threshold is yours to choose --
     put it on the panel's pot and you can change your mind without editing
     the program.

   DONE WHEN
     Cartons above your threshold go down the chute and the rest pass, and
     moving the pot moves the boundary with no other change. The two
     counters together equal what the curtain measured. The mushroom
     (panel.estop, normally closed) stops the belt within 200 ms and its
     trip latches: releasing it restarts nothing, and neither does Start or
     Reset alone -- only Reset, then Start.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               belt.rotate
     0x1      1     %QX100.1               diverter.extend
     0x2      1     %QX100.2               emitter.emit
     0x3      1     %QX100.3               panel.green
     0x4      1     %QX100.4               panel.red
     1x0      1     %IX100.0               belt.fault
     1x1      1     %IX100.1               diverter.extended
     1x2      1     %IX100.2               diverter.fault
     1x3      1     %IX100.3               diverter.retracted
     1x4      1     %IX100.4               height_gauge.blocked
     1x5      1     %IX100.5               panel.estop
     1x6      1     %IX100.6               panel.reset
     1x7      1     %IX100.7               panel.start
     1x8      1     %IX101.0               panel.stop
     3x0      2     %IW100 + %IW101        height_gauge.height
     3x2      2     %IW102 + %IW103        panel.setpoint
     3x4      2     %IW104 + %IW105        short_count.count
     3x6      2     %IW106 + %IW107        tall_count.count
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

PROGRAM light_curtain_sorting
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    BeltRotate     AT %QX100.0  : BOOL;  (* belt.rotate     0x0   run the belt *)
    DiverterExtend AT %QX100.1  : BOOL;  (* diverter.extend 0x1   extend the pusher *)
    EmitterEmit    AT %QX100.2  : BOOL;  (* emitter.emit    0x2   rising edge = feed one carton; hold each level well over one poll *)
    PanelGreen     AT %QX100.3  : BOOL;  (* panel.green     0x3   green lamp on the panel *)
    PanelRed       AT %QX100.4  : BOOL;  (* panel.red       0x4   red lamp on the panel *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    BeltFault          AT %IX100.0  : BOOL;  (* belt.fault           1x0   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    DiverterExtended   AT %IX100.1  : BOOL;  (* diverter.extended    1x1   pusher fully out *)
    DiverterFault      AT %IX100.2  : BOOL;  (* diverter.fault       1x2   drive fault: TRUE = jammed; it freezes where it is *)
    DiverterRetracted  AT %IX100.3  : BOOL;  (* diverter.retracted   1x3   pusher fully back *)
    HeightGaugeBlocked AT %IX100.4  : BOOL;  (* height_gauge.blocked 1x4   light curtain: TRUE while any beam is blocked *)
    PanelEstop         AT %IX100.5  : BOOL;  (* panel.estop          1x5   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset         AT %IX100.6  : BOOL;  (* panel.reset          1x6   Reset button, momentary: a short pulse per press *)
    PanelStart         AT %IX100.7  : BOOL;  (* panel.start          1x7   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop          AT %IX101.0  : BOOL;  (* panel.stop           1x8   Stop button, momentary: a short pulse per press *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    HeightGaugeHeightHi AT %IW100    : WORD;  (* height_gauge.height 3x0   high word of HeightGaugeHeight *)
    HeightGaugeHeightLo AT %IW101    : WORD;  (* height_gauge.height 3x1   low word of HeightGaugeHeight *)
    PanelSetpointHi     AT %IW102    : WORD;  (* panel.setpoint      3x2   high word of PanelSetpoint *)
    PanelSetpointLo     AT %IW103    : WORD;  (* panel.setpoint      3x3   low word of PanelSetpoint *)
    ShortCountCountHi   AT %IW104    : WORD;  (* short_count.count   3x4   high word of ShortCountCount *)
    ShortCountCountLo   AT %IW105    : WORD;  (* short_count.count   3x5   low word of ShortCountCount *)
    TallCountCountHi    AT %IW106    : WORD;  (* tall_count.count    3x6   high word of TallCountCount *)
    TallCountCountLo    AT %IW107    : WORD;  (* tall_count.count    3x7   low word of TallCountCount *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    HeightGaugeHeight : REAL;  (* height_gauge.height light curtain: height of the tallest blocked beam, m (0 when clear) *)
    PanelSetpoint     : REAL;  (* panel.setpoint      the operator's pot, 0..0.5 m (starts at 0.15) *)
    ShortCountCount   : DINT;  (* short_count.count   cartons this remover has taken off the line, running total *)
    TallCountCount    : DINT;  (* tall_count.count    cartons this remover has taken off the line, running total *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  HeightGaugeHeight := FF_WORDS_TO_REAL(HI := HeightGaugeHeightHi, LO := HeightGaugeHeightLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  ShortCountCount := FF_WORDS_TO_DINT(HI := ShortCountCountHi, LO := ShortCountCountLo);
  TallCountCount := FF_WORDS_TO_DINT(HI := TallCountCountHi, LO := TallCountCountLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through HeightGaugeHeight, PanelSetpoint,
     ShortCountCount, TallCountCount.

     FIRST SCANS READ FALSE. OpenPLC scans before its first Modbus poll
     returns, and until then every input reads FALSE. PanelEstop is
     normally closed, so it looks struck, and a trip latched on NOT
     PanelEstop trips itself every time OpenPLC starts. Arm the trip
     only once the E-stop has read healthy, and keep refusing Start
     while it reads FALSE (docs/OPENPLC.md, Troubleshooting):
       EstopSeen : BOOL;   in the second VAR block
       IF PanelEstop THEN EstopSeen := TRUE; END_IF;
       IF EstopSeen AND NOT PanelEstop THEN Tripped := TRUE; END_IF; *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  (* none in this scene *)

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : light_curtain_sorting;
  END_RESOURCE

END_CONFIGURATION
