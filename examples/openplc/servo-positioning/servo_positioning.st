(* ------------------------------------------------------------------------
   FactoryForge starter -- Servo positioning (scene servo-positioning)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Shuttle the axis between station A at 100 mm and station B, the
     panel's pot, dwelling a second at each, from Start until Stop. The
     drive does nothing until axis.enable has been on long enough for
     axis.ready, and every move needs axis.velocity as well as axis.target.
     When the drive faults it stops itself and latches axis.error: hold
     your sequence, show it, and acknowledge -- a rising edge of axis.ack
     -- only when the operator presses Reset and axis.fault has gone.

   DONE WHEN
     The carriage stops on A and on B in turn, and on the new B as soon as
     you turn the pot. Raise axis.fault mid-move and the carriage quick-
     stops; clear it, and nothing moves until somebody presses Reset -- a
     program that acknowledges on its own is automatic restart by another
     name. Careful with inposition: on the scan that writes a new target it
     still describes the old one, so arrive on axis.position against the
     station you are going to.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               axis.ack
     0x1      1     %QX100.1               axis.enable
     0x2      1     %QX100.2               panel.green
     0x3      1     %QX100.3               panel.red
     0x4      1     %QX100.4               tower.green
     0x5      1     %QX100.5               tower.red
     0x6      1     %QX100.6               tower.yellow
     1x0      1     %IX100.0               axis.error
     1x1      1     %IX100.1               axis.fault
     1x2      1     %IX100.2               axis.inposition
     1x3      1     %IX100.3               axis.ready
     1x4      1     %IX100.4               panel.estop
     1x5      1     %IX100.5               panel.reset
     1x6      1     %IX100.6               panel.start
     1x7      1     %IX100.7               panel.stop
     4x0      2     %QW100 + %QW101        axis.target
     4x2      2     %QW102 + %QW103        axis.velocity
     4x4      2     %QW104 + %QW105        position_display.value
     3x0      2     %IW100 + %IW101        axis.position
     3x2      2     %IW102 + %IW103        panel.setpoint
   ------------------------------------------------------------------------ *)

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM servo_positioning
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    AxisAck     AT %QX100.0  : BOOL;  (* axis.ack     0x0   acknowledge a latched error: RISING edge, and only once its cause has gone *)
    AxisEnable  AT %QX100.1  : BOOL;  (* axis.enable  0x1   power the drive (a level, like MC_Power.Enable) *)
    PanelGreen  AT %QX100.2  : BOOL;  (* panel.green  0x2   green lamp on the panel *)
    PanelRed    AT %QX100.3  : BOOL;  (* panel.red    0x3   red lamp on the panel *)
    TowerGreen  AT %QX100.4  : BOOL;  (* tower.green  0x4   tower lamp, green *)
    TowerRed    AT %QX100.5  : BOOL;  (* tower.red    0x5   tower lamp, red *)
    TowerYellow AT %QX100.6  : BOOL;  (* tower.yellow 0x6   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    AxisTargetHi           AT %QW100    : WORD;  (* axis.target            4x0   high word of AxisTarget *)
    AxisTargetLo           AT %QW101    : WORD;  (* axis.target            4x1   low word of AxisTarget *)
    AxisVelocityHi         AT %QW102    : WORD;  (* axis.velocity          4x2   high word of AxisVelocity *)
    AxisVelocityLo         AT %QW103    : WORD;  (* axis.velocity          4x3   low word of AxisVelocity *)
    PositionDisplayValueHi AT %QW104    : WORD;  (* position_display.value 4x4   high word of PositionDisplayValue *)
    PositionDisplayValueLo AT %QW105    : WORD;  (* position_display.value 4x5   low word of PositionDisplayValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    AxisError      AT %IX100.0  : BOOL;  (* axis.error      1x0   latched drive error: the axis has stopped itself and waits for an acknowledge *)
    AxisFault      AT %IX100.1  : BOOL;  (* axis.fault      1x1   drive fault present: TRUE = the cause of an error is still there *)
    AxisInposition AT %IX100.2  : BOOL;  (* axis.inposition 1x2   stopped within 0.5 mm of the target it holds NOW -- stale on the scan you change the target *)
    AxisReady      AT %IX100.3  : BOOL;  (* axis.ready      1x3   powered and error-free *)
    PanelEstop     AT %IX100.4  : BOOL;  (* panel.estop     1x4   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset     AT %IX100.5  : BOOL;  (* panel.reset     1x5   Reset button, momentary: a short pulse per press *)
    PanelStart     AT %IX100.6  : BOOL;  (* panel.start     1x6   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop      AT %IX100.7  : BOOL;  (* panel.stop      1x7   Stop button, momentary: a short pulse per press *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    AxisPositionHi  AT %IW100    : WORD;  (* axis.position  3x0   high word of AxisPosition *)
    AxisPositionLo  AT %IW101    : WORD;  (* axis.position  3x1   low word of AxisPosition *)
    PanelSetpointHi AT %IW102    : WORD;  (* panel.setpoint 3x2   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW103    : WORD;  (* panel.setpoint 3x3   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    AxisPosition         : REAL;  (* axis.position  actual position, mm *)
    PanelSetpoint        : REAL;  (* panel.setpoint the operator's pot, 300..950 mm (starts at 800) *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    AxisTarget           : REAL;  (* axis.target            target position, mm, 0..1000 *)
    AxisVelocity         : REAL;  (* axis.velocity          move velocity, mm/s (the axis caps it at 500) *)
    PositionDisplayValue : DINT;  (* position_display.value number shown on the display (mm) *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  AxisPosition := FF_WORDS_TO_REAL(HI := AxisPositionHi, LO := AxisPositionLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through AxisPosition, PanelSetpoint, AxisTarget,
     AxisVelocity, PositionDisplayValue. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(AxisTarget);
  AxisTargetHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  AxisTargetLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(AxisVelocity);
  AxisVelocityHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  AxisVelocityLo := DWORD_TO_WORD(Raw32);
  Raw32 := DINT_TO_DWORD(PositionDisplayValue);
  PositionDisplayValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  PositionDisplayValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : servo_positioning;
  END_RESOURCE

END_CONFIGURATION
