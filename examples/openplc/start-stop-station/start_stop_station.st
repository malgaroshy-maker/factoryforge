(* ------------------------------------------------------------------------
   FactoryForge starter -- Start / stop station (scene start-stop-station)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     The operator contract, on its own. Start runs the belt, Stop stops it,
     and the mushroom latches a trip that only Reset clears. Feed a batch
     of the size the panel's pot asks for and stop when it is made.

   DONE WHEN
     The batch count reaches the setpoint and the line stops itself.
     Pressing Start while tripped does nothing; releasing the mushroom does
     not restart it either. Only Reset then Start brings it back.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               belt.rotate
     0x1      1     %QX100.1               emitter.emit
     0x2      1     %QX100.2               panel.green
     0x3      1     %QX100.3               panel.red
     0x4      1     %QX100.4               tower.green
     0x5      1     %QX100.5               tower.red
     0x6      1     %QX100.6               tower.yellow
     1x0      1     %IX100.0               belt.fault
     1x1      1     %IX100.1               panel.estop
     1x2      1     %IX100.2               panel.reset
     1x3      1     %IX100.3               panel.start
     1x4      1     %IX100.4               panel.stop
     1x5      1     %IX100.5               part_present.detect
     4x0      2     %QW100 + %QW101        produced.value
     3x0      2     %IW100 + %IW101        counter.count
     3x2      2     %IW102 + %IW103        panel.setpoint
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

PROGRAM start_stop_station
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    BeltRotate  AT %QX100.0  : BOOL;  (* belt.rotate  0x0   run the belt *)
    EmitterEmit AT %QX100.1  : BOOL;  (* emitter.emit 0x1   rising edge = feed one carton; hold each level well over one poll *)
    PanelGreen  AT %QX100.2  : BOOL;  (* panel.green  0x2   green lamp on the panel *)
    PanelRed    AT %QX100.3  : BOOL;  (* panel.red    0x3   red lamp on the panel *)
    TowerGreen  AT %QX100.4  : BOOL;  (* tower.green  0x4   tower lamp, green *)
    TowerRed    AT %QX100.5  : BOOL;  (* tower.red    0x5   tower lamp, red *)
    TowerYellow AT %QX100.6  : BOOL;  (* tower.yellow 0x6   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    ProducedValueHi AT %QW100    : WORD;  (* produced.value 4x0   high word of ProducedValue *)
    ProducedValueLo AT %QW101    : WORD;  (* produced.value 4x1   low word of ProducedValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    BeltFault         AT %IX100.0  : BOOL;  (* belt.fault          1x0   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    PanelEstop        AT %IX100.1  : BOOL;  (* panel.estop         1x1   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset        AT %IX100.2  : BOOL;  (* panel.reset         1x2   Reset button, momentary: a short pulse per press *)
    PanelStart        AT %IX100.3  : BOOL;  (* panel.start         1x3   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop         AT %IX100.4  : BOOL;  (* panel.stop          1x4   Stop button, momentary: a short pulse per press *)
    PartPresentDetect AT %IX100.5  : BOOL;  (* part_present.detect 1x5   TRUE while a carton is in the beam *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    CounterCountHi  AT %IW100    : WORD;  (* counter.count  3x0   high word of CounterCount *)
    CounterCountLo  AT %IW101    : WORD;  (* counter.count  3x1   low word of CounterCount *)
    PanelSetpointHi AT %IW102    : WORD;  (* panel.setpoint 3x2   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW103    : WORD;  (* panel.setpoint 3x3   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    CounterCount  : DINT;  (* counter.count  cartons this remover has taken off the line, running total *)
    PanelSetpoint : REAL;  (* panel.setpoint the operator's pot, 0..50 pcs (starts at 12) *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    ProducedValue : DINT;  (* produced.value number shown on the display (pcs) *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  CounterCount := FF_WORDS_TO_DINT(HI := CounterCountHi, LO := CounterCountLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through CounterCount, PanelSetpoint, ProducedValue.

     FIRST SCANS READ FALSE. OpenPLC scans before its first Modbus poll
     returns, and until then every input reads FALSE. PanelEstop is
     normally closed, so it looks struck, and a trip latched on NOT
     PanelEstop trips itself every time OpenPLC starts. Arm the trip
     only once the E-stop has read healthy, and keep refusing Start
     while it reads FALSE (docs/OPENPLC.md, Troubleshooting):
       EstopSeen : BOOL;   in the second VAR block
       IF PanelEstop THEN EstopSeen := TRUE; END_IF;
       IF EstopSeen AND NOT PanelEstop THEN Tripped := TRUE; END_IF; *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := DINT_TO_DWORD(ProducedValue);
  ProducedValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  ProducedValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : start_stop_station;
  END_RESOURCE

END_CONFIGURATION
