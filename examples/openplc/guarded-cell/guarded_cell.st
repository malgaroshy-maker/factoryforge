(* ------------------------------------------------------------------------
   FactoryForge starter -- Guarded cell (scene guarded-cell)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Run the transfer cell without ever writing belt.rotate. You command
     starter.coil; the contactor runs the motor. The safety relay watches
     one interlock contact from each leaf of the cell gate and holds your
     coil off until both leaves are shut and somebody presses Reset -- so
     the relay closing hands the coil back and starts nothing. Cartons have
     to cross the scanner's protective field, so bridge it with
     scanner.mute while each one passes; the panel's pot is how long you
     bridge it for. Then transfer each carton into the chute with the
     cylinder, sequencing on the two reeds and never energising both coils.

   DONE WHEN
     Cartons reach transferred.count while your program has never written
     belt.rotate -- belt.rotate follows starter.aux, because the contactor
     runs the motor and you only run the coil. Opening either gate leaf
     stops the cell inside 200 ms; closing both and pressing Reset lights
     relay.k1 and starts nothing at all, and Start is what starts it. Open
     one leaf on its own and, past the relay's sync window, relay.fault
     latches: a reset while it is still open will not clear it. Finally
     turn the pot past the scanner's own mute limit and watch scanner.muted
     go out while scanner.mute is still commanded -- your mute stopped being
     a mute, the next carton in the field stopped the cell, and that is
     what a mute without a limit hides.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).
     This scene's coil block starts at 0x1, not 0x0, so
     %QX100.0 is slave coil 1 -- see NOT WIRED below.

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     (not wired)            belt.rotate
     0x1      1     %QX100.0               cylinder.extend
     0x2      1     %QX100.1               cylinder.retract
     0x3      1     %QX100.2               emitter.emit
     0x4      1     %QX100.3               guard_a.lock
     0x5      1     %QX100.4               guard_b.lock
     0x6      1     %QX100.5               panel.green
     0x7      1     %QX100.6               panel.red
     0x8      1     %QX100.7               relay.reset
     0x9      1     %QX101.0               scanner.mute
     0x10     1     %QX101.1               starter.coil
     0x11     1     %QX101.2               tower.green
     0x12     1     %QX101.3               tower.red
     0x13     1     %QX101.4               tower.yellow
     1x0      1     %IX100.0               belt.fault
     1x1      1     %IX100.1               cylinder.extended
     1x2      1     %IX100.2               cylinder.fault
     1x3      1     %IX100.3               cylinder.retracted
     1x4      1     %IX100.4               guard_a.closed
     1x5      1     %IX100.5               guard_a.locked
     1x6      1     %IX100.6               guard_b.closed
     1x7      1     %IX100.7               guard_b.locked
     1x8      1     %IX101.0               mute_eye.detect
     1x9      1     %IX101.1               panel.estop
     1x10     1     %IX101.2               panel.reset
     1x11     1     %IX101.3               panel.start
     1x12     1     %IX101.4               panel.stop
     1x13     1     %IX101.5               push_eye.detect
     1x14     1     %IX101.6               relay.cha
     1x15     1     %IX101.7               relay.chb
     1x16     1     %IX102.0               relay.fault
     1x17     1     %IX102.1               relay.k1
     1x18     1     %IX102.2               relay.k2
     1x19     1     %IX102.3               scanner.muted
     1x20     1     %IX102.4               scanner.stop
     1x21     1     %IX102.5               scanner.warn
     1x22     1     %IX102.6               starter.aux
     1x23     1     %IX102.7               starter.overload
     3x0      2     %IW100 + %IW101        line_end.count
     3x2      2     %IW102 + %IW103        panel.setpoint
     3x4      2     %IW104 + %IW105        starter.current
     3x6      2     %IW106 + %IW107        transferred.count

   NOT WIRED
     belt.rotate: starter.coil's contactor drives it; a program that writes
     it fails this exercise. It is left out of the coil block, so OpenPLC
     never writes it.
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

PROGRAM guarded_cell
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    CylinderExtend  AT %QX100.0  : BOOL;  (* cylinder.extend  0x1   extend coil (5/2 valve, no spring: the rod stays where it was last driven) *)
    CylinderRetract AT %QX100.1  : BOOL;  (* cylinder.retract 0x2   retract coil *)
    EmitterEmit     AT %QX100.2  : BOOL;  (* emitter.emit     0x3   rising edge = feed one carton; hold each level well over one poll *)
    GuardALock      AT %QX100.3  : BOOL;  (* guard_a.lock     0x4   energise the solenoid lock (it only bites on a shut door) *)
    GuardBLock      AT %QX100.4  : BOOL;  (* guard_b.lock     0x5   energise the solenoid lock (it only bites on a shut door) *)
    PanelGreen      AT %QX100.5  : BOOL;  (* panel.green      0x6   green lamp on the panel *)
    PanelRed        AT %QX100.6  : BOOL;  (* panel.red        0x7   red lamp on the panel *)
    RelayReset      AT %QX100.7  : BOOL;  (* relay.reset      0x8   reset: the relay closes on a RISING edge, and only with both channels healthy *)
    ScannerMute     AT %QX101.0  : BOOL;  (* scanner.mute     0x9   request muting; honoured for at most 6 s at a stretch *)
    StarterCoil     AT %QX101.1  : BOOL;  (* starter.coil     0x10  contactor coil -- the contactor runs belt.rotate *)
    TowerGreen      AT %QX101.2  : BOOL;  (* tower.green      0x11  tower lamp, green *)
    TowerRed        AT %QX101.3  : BOOL;  (* tower.red        0x12  tower lamp, red *)
    TowerYellow     AT %QX101.4  : BOOL;  (* tower.yellow     0x13  tower lamp, yellow *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    BeltFault         AT %IX100.0  : BOOL;  (* belt.fault         1x0   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    CylinderExtended  AT %IX100.1  : BOOL;  (* cylinder.extended  1x1   reed switch at full stroke *)
    CylinderFault     AT %IX100.2  : BOOL;  (* cylinder.fault     1x2   TRUE = the cylinder has seized *)
    CylinderRetracted AT %IX100.3  : BOOL;  (* cylinder.retracted 1x3   reed switch at home; mid-stroke neither reed is made *)
    GuardAClosed      AT %IX100.4  : BOOL;  (* guard_a.closed     1x4   guard switch, normally closed: TRUE while the door is shut *)
    GuardALocked      AT %IX100.5  : BOOL;  (* guard_a.locked     1x5   TRUE while the door is locked shut *)
    GuardBClosed      AT %IX100.6  : BOOL;  (* guard_b.closed     1x6   guard switch, normally closed: TRUE while the door is shut *)
    GuardBLocked      AT %IX100.7  : BOOL;  (* guard_b.locked     1x7   TRUE while the door is locked shut *)
    MuteEyeDetect     AT %IX101.0  : BOOL;  (* mute_eye.detect    1x8   TRUE while a carton is in the beam *)
    PanelEstop        AT %IX101.1  : BOOL;  (* panel.estop        1x9   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset        AT %IX101.2  : BOOL;  (* panel.reset        1x10  Reset button, momentary: a short pulse per press *)
    PanelStart        AT %IX101.3  : BOOL;  (* panel.start        1x11  Start button, momentary: a short pulse per press -- latch it *)
    PanelStop         AT %IX101.4  : BOOL;  (* panel.stop         1x12  Stop button, momentary: a short pulse per press *)
    PushEyeDetect     AT %IX101.5  : BOOL;  (* push_eye.detect    1x13  TRUE while a carton is in the beam *)
    RelayCha          AT %IX101.6  : BOOL;  (* relay.cha          1x14  channel A as the relay sees it (guard_a.closed) *)
    RelayChb          AT %IX101.7  : BOOL;  (* relay.chb          1x15  channel B as the relay sees it (guard_b.closed) *)
    RelayFault        AT %IX102.0  : BOOL;  (* relay.fault        1x16  TRUE = the two channels disagreed; the relay latches this fault *)
    RelayK1           AT %IX102.1  : BOOL;  (* relay.k1           1x17  safety contact K1: TRUE while the relay's outputs are closed (open, they hold starter.coil FALSE) *)
    RelayK2           AT %IX102.2  : BOOL;  (* relay.k2           1x18  safety contact K2: TRUE while the relay's outputs are closed *)
    ScannerMuted      AT %IX102.3  : BOOL;  (* scanner.muted      1x19  TRUE while muting is actually in force *)
    ScannerStop       AT %IX102.4  : BOOL;  (* scanner.stop       1x20  protective field clear, normally closed: TRUE = clear, FALSE = someone is in it *)
    ScannerWarn       AT %IX102.5  : BOOL;  (* scanner.warn       1x21  TRUE while the warning field is broken *)
    StarterAux        AT %IX102.6  : BOOL;  (* starter.aux        1x22  auxiliary contact: TRUE while the contactor has really pulled in *)
    StarterOverload   AT %IX102.7  : BOOL;  (* starter.overload   1x23  thermal overload, normally closed: TRUE = OK, FALSE = tripped *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    LineEndCountHi     AT %IW100    : WORD;  (* line_end.count    3x0   high word of LineEndCount *)
    LineEndCountLo     AT %IW101    : WORD;  (* line_end.count    3x1   low word of LineEndCount *)
    PanelSetpointHi    AT %IW102    : WORD;  (* panel.setpoint    3x2   high word of PanelSetpoint *)
    PanelSetpointLo    AT %IW103    : WORD;  (* panel.setpoint    3x3   low word of PanelSetpoint *)
    StarterCurrentHi   AT %IW104    : WORD;  (* starter.current   3x4   high word of StarterCurrent *)
    StarterCurrentLo   AT %IW105    : WORD;  (* starter.current   3x5   low word of StarterCurrent *)
    TransferredCountHi AT %IW106    : WORD;  (* transferred.count 3x6   high word of TransferredCount *)
    TransferredCountLo AT %IW107    : WORD;  (* transferred.count 3x7   low word of TransferredCount *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    LineEndCount     : DINT;  (* line_end.count    cartons this remover has taken off the line, running total *)
    PanelSetpoint    : REAL;  (* panel.setpoint    the operator's pot, 1..10 s (starts at 3.5) *)
    StarterCurrent   : REAL;  (* starter.current   motor current, A *)
    TransferredCount : DINT;  (* transferred.count cartons this remover has taken off the line, running total *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  LineEndCount := FF_WORDS_TO_DINT(HI := LineEndCountHi, LO := LineEndCountLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  StarterCurrent := FF_WORDS_TO_REAL(HI := StarterCurrentHi, LO := StarterCurrentLo);
  TransferredCount := FF_WORDS_TO_DINT(HI := TransferredCountHi, LO := TransferredCountLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through LineEndCount, PanelSetpoint, StarterCurrent,
     TransferredCount. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  (* none in this scene *)

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : guarded_cell;
  END_RESOURCE

END_CONFIGURATION
