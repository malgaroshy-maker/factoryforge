(* ------------------------------------------------------------------------
   FactoryForge starter -- Pick & place cell (scene pick-and-place-cell)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Sequence three motions against feedback, not timers. Ramp the infeed
     drive, read each carton's code at the scanner, then travel , lower ,
     grip , raise , travel , release to put it on the outfeed. The gantry
     reports whether the vacuum actually caught anything.

   DONE WHEN
     Every carton fed reaches the outfeed, and gantry.holding is true on
     every carry -- a cycle that runs with holding false carried air.
     Careful with inposition: a target written this scan does not reach the
     machine until the next one, so on the scan that issues a move it still
     reports the place you are trying to leave.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open:

       factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               alarm.beacon
     0x1      1     %QX100.1               alarm.horn
     0x2      1     %QX100.2               emitter.emit
     0x3      1     %QX100.3               gantry.grip
     0x4      1     %QX100.4               gantry.lower
     0x5      1     %QX100.5               infeed.run
     0x6      1     %QX100.6               panel.green
     0x7      1     %QX100.7               panel.red
     0x8      1     %QX101.0               pickstation.rotate
     0x9      1     %QX101.1               scanner.enable
     0x10     1     %QX101.2               tower.green
     0x11     1     %QX101.3               tower.red
     0x12     1     %QX101.4               tower.yellow
     1x0      1     %IX100.0               atstation.detect
     1x1      1     %IX100.1               gantry.fault
     1x2      1     %IX100.2               gantry.holding
     1x3      1     %IX100.3               gantry.inposition
     1x4      1     %IX100.4               gantry.lowered
     1x5      1     %IX100.5               gantry.raised
     1x6      1     %IX100.6               infeed.fault
     1x7      1     %IX100.7               panel.estop
     1x8      1     %IX101.0               panel.reset
     1x9      1     %IX101.1               panel.start
     1x10     1     %IX101.2               panel.stop
     1x11     1     %IX101.3               pickstation.fault
     1x12     1     %IX101.4               scanner.present
     1x13     1     %IX101.5               scanner.read
     4x0      2     %QW100 + %QW101        gantry.target
     4x2      2     %QW102 + %QW103        infeed.speed
     4x4      2     %QW104 + %QW105        rate.value
     3x0      2     %IW100 + %IW101        gantry.position
     3x2      2     %IW102 + %IW103        infeed.actual
     3x4      2     %IW104 + %IW105        outfeed.count
     3x6      2     %IW106 + %IW107        panel.setpoint
     3x8      2     %IW108 + %IW109        scanner.code
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM pick_and_place_cell
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    AlarmBeacon       AT %QX100.0  : BOOL;  (* alarm.beacon       0x0   rotating alarm beacon *)
    AlarmHorn         AT %QX100.1  : BOOL;  (* alarm.horn         0x1   alarm horn *)
    EmitterEmit       AT %QX100.2  : BOOL;  (* emitter.emit       0x2   rising edge = feed one carton; hold each level well over one poll; every 4th carton is steel *)
    GantryGrip        AT %QX100.3  : BOOL;  (* gantry.grip        0x3   vacuum on *)
    GantryLower       AT %QX100.4  : BOOL;  (* gantry.lower       0x4   lower the cup (FALSE raises it) *)
    InfeedRun         AT %QX100.5  : BOOL;  (* infeed.run         0x5   run the drive *)
    PanelGreen        AT %QX100.6  : BOOL;  (* panel.green        0x6   green lamp on the panel *)
    PanelRed          AT %QX100.7  : BOOL;  (* panel.red          0x7   red lamp on the panel *)
    PickstationRotate AT %QX101.0  : BOOL;  (* pickstation.rotate 0x8   run the belt *)
    ScannerEnable     AT %QX101.1  : BOOL;  (* scanner.enable     0x9   arm the reader; FALSE switches it off -- and an output you never write is FALSE *)
    TowerGreen        AT %QX101.2  : BOOL;  (* tower.green        0x10  tower lamp, green *)
    TowerRed          AT %QX101.3  : BOOL;  (* tower.red          0x11  tower lamp, red *)
    TowerYellow       AT %QX101.4  : BOOL;  (* tower.yellow       0x12  tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    GantryTargetHi AT %QW100    : WORD;  (* gantry.target 4x0   high word of GantryTarget *)
    GantryTargetLo AT %QW101    : WORD;  (* gantry.target 4x1   low word of GantryTarget *)
    InfeedSpeedHi  AT %QW102    : WORD;  (* infeed.speed  4x2   high word of InfeedSpeed *)
    InfeedSpeedLo  AT %QW103    : WORD;  (* infeed.speed  4x3   low word of InfeedSpeed *)
    RateValueHi    AT %QW104    : WORD;  (* rate.value    4x4   high word of RateValue *)
    RateValueLo    AT %QW105    : WORD;  (* rate.value    4x5   low word of RateValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    AtstationDetect  AT %IX100.0  : BOOL;  (* atstation.detect  1x0   TRUE while a carton is in the beam *)
    GantryFault      AT %IX100.1  : BOOL;  (* gantry.fault      1x1   drive fault: TRUE = faulted *)
    GantryHolding    AT %IX100.2  : BOOL;  (* gantry.holding    1x2   the vacuum really has a carton (not just: grip is on) *)
    GantryInposition AT %IX100.3  : BOOL;  (* gantry.inposition 1x3   within 1.5 % of the target it holds NOW -- stale on the scan you change the target *)
    GantryLowered    AT %IX100.4  : BOOL;  (* gantry.lowered    1x4   cup fully down *)
    GantryRaised     AT %IX100.5  : BOOL;  (* gantry.raised     1x5   cup fully up *)
    InfeedFault      AT %IX100.6  : BOOL;  (* infeed.fault      1x6   drive fault: TRUE = faulted; a faulted drive does not turn *)
    PanelEstop       AT %IX100.7  : BOOL;  (* panel.estop       1x7   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset       AT %IX101.0  : BOOL;  (* panel.reset       1x8   Reset button, momentary: a short pulse per press *)
    PanelStart       AT %IX101.1  : BOOL;  (* panel.start       1x9   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop        AT %IX101.2  : BOOL;  (* panel.stop        1x10  Stop button, momentary: a short pulse per press *)
    PickstationFault AT %IX101.3  : BOOL;  (* pickstation.fault 1x11  drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    ScannerPresent   AT %IX101.4  : BOOL;  (* scanner.present   1x12  TRUE while a carton is under the reader *)
    ScannerRead      AT %IX101.5  : BOOL;  (* scanner.read      1x13  TRUE for 0.2 s on each new read, as `code` changes -- latch the code on the rising edge *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    GantryPositionHi AT %IW100    : WORD;  (* gantry.position 3x0   high word of GantryPosition *)
    GantryPositionLo AT %IW101    : WORD;  (* gantry.position 3x1   low word of GantryPosition *)
    InfeedActualHi   AT %IW102    : WORD;  (* infeed.actual   3x2   high word of InfeedActual *)
    InfeedActualLo   AT %IW103    : WORD;  (* infeed.actual   3x3   low word of InfeedActual *)
    OutfeedCountHi   AT %IW104    : WORD;  (* outfeed.count   3x4   high word of OutfeedCount *)
    OutfeedCountLo   AT %IW105    : WORD;  (* outfeed.count   3x5   low word of OutfeedCount *)
    PanelSetpointHi  AT %IW106    : WORD;  (* panel.setpoint  3x6   high word of PanelSetpoint *)
    PanelSetpointLo  AT %IW107    : WORD;  (* panel.setpoint  3x7   low word of PanelSetpoint *)
    ScannerCodeHi    AT %IW108    : WORD;  (* scanner.code    3x8   high word of ScannerCode *)
    ScannerCodeLo    AT %IW109    : WORD;  (* scanner.code    3x9   low word of ScannerCode *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    GantryPosition : REAL;  (* gantry.position rail position now, 0..100 % *)
    InfeedActual   : REAL;  (* infeed.actual   actual speed, % -- lags the reference while the drive ramps *)
    OutfeedCount   : DINT;  (* outfeed.count   cartons this remover has taken off the line, running total *)
    PanelSetpoint  : REAL;  (* panel.setpoint  the operator's pot, 10..100 % (starts at 60) *)
    ScannerCode    : DINT;  (* scanner.code    last code read, held until the next: 101 short, 102 tall, 201 metal *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    GantryTarget   : REAL;  (* gantry.target rail position to travel to, 0..100 % of the 2.4 m rail *)
    InfeedSpeed    : REAL;  (* infeed.speed  speed reference, 0..100 % of 0.8 m/s; the drive ramps towards it *)
    RateValue      : REAL;  (* rate.value    needle position, scale 0..100 % *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  GantryPosition := FF_WORDS_TO_REAL(HI := GantryPositionHi, LO := GantryPositionLo);
  InfeedActual := FF_WORDS_TO_REAL(HI := InfeedActualHi, LO := InfeedActualLo);
  OutfeedCount := FF_WORDS_TO_DINT(HI := OutfeedCountHi, LO := OutfeedCountLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  ScannerCode := FF_WORDS_TO_DINT(HI := ScannerCodeHi, LO := ScannerCodeLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through GantryPosition, InfeedActual, OutfeedCount,
     PanelSetpoint, ScannerCode, GantryTarget, InfeedSpeed, RateValue. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(GantryTarget);
  GantryTargetHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  GantryTargetLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(InfeedSpeed);
  InfeedSpeedHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  InfeedSpeedLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(RateValue);
  RateValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  RateValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : pick_and_place_cell;
  END_RESOURCE

END_CONFIGURATION
