(* ------------------------------------------------------------------------
   FactoryForge starter -- Cooling tunnel (scene cooling-tunnel)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Hold the product at the temperature on the panel's pot. The heater can
     only push the temperature up and the room takes heat away slowly, so
     the fan is how it comes down fast: split one controller's output,
     heater above zero and fan below it, with a deadband between them.
     Never run both at once. fan.speed is a reference -- the fan ramps, and
     fan.airflow is what it is really delivering.

   DONE WHEN
     The product settles within a few degrees of the pot and holds there.
     Drop the pot 60 C and it comes down in seconds with the fan, not in a
     quarter of a minute on the room; raise it again and the heater takes
     back over with the fan stopped. A fan left running while the heater
     trims holds every setpoint and heats the air it blows away -- watch
     oven.heater and fan.airflow and they are never both up. Fail the fan
     (fan.fault) and fan.speed keeps reading your reference while the
     airflow collapses. The mushroom (panel.estop, normally closed) stops
     the heater and the fan within 200 ms and its trip latches: releasing
     it restarts nothing, and neither does Start or Reset alone -- only
     Reset, then Start.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               fan.run
     0x1      1     %QX100.1               panel.green
     0x2      1     %QX100.2               panel.red
     0x3      1     %QX100.3               tower.green
     0x4      1     %QX100.4               tower.red
     0x5      1     %QX100.5               tower.yellow
     1x0      1     %IX100.0               fan.fault
     1x1      1     %IX100.1               oven.attemp
     1x2      1     %IX100.2               oven.fault
     1x3      1     %IX100.3               panel.estop
     1x4      1     %IX100.4               panel.reset
     1x5      1     %IX100.5               panel.start
     1x6      1     %IX100.6               panel.stop
     4x0      2     %QW100 + %QW101        fan.speed
     4x2      2     %QW102 + %QW103        oven.heater
     4x4      2     %QW104 + %QW105        temp_gauge.value
     3x0      2     %IW100 + %IW101        fan.airflow
     3x2      2     %IW102 + %IW103        oven.temperature
     3x4      2     %IW104 + %IW105        panel.setpoint
   ------------------------------------------------------------------------ *)

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM cooling_tunnel
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    FanRun      AT %QX100.0  : BOOL;  (* fan.run      0x0   run the fan *)
    PanelGreen  AT %QX100.1  : BOOL;  (* panel.green  0x1   green lamp on the panel *)
    PanelRed    AT %QX100.2  : BOOL;  (* panel.red    0x2   red lamp on the panel *)
    TowerGreen  AT %QX100.3  : BOOL;  (* tower.green  0x3   tower lamp, green *)
    TowerRed    AT %QX100.4  : BOOL;  (* tower.red    0x4   tower lamp, red *)
    TowerYellow AT %QX100.5  : BOOL;  (* tower.yellow 0x5   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    FanSpeedHi       AT %QW100    : WORD;  (* fan.speed        4x0   high word of FanSpeed *)
    FanSpeedLo       AT %QW101    : WORD;  (* fan.speed        4x1   low word of FanSpeed *)
    OvenHeaterHi     AT %QW102    : WORD;  (* oven.heater      4x2   high word of OvenHeater *)
    OvenHeaterLo     AT %QW103    : WORD;  (* oven.heater      4x3   low word of OvenHeater *)
    TempGaugeValueHi AT %QW104    : WORD;  (* temp_gauge.value 4x4   high word of TempGaugeValue *)
    TempGaugeValueLo AT %QW105    : WORD;  (* temp_gauge.value 4x5   low word of TempGaugeValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    FanFault   AT %IX100.0  : BOOL;  (* fan.fault   1x0   fan motor failed: TRUE = it takes your reference and blows nothing *)
    OvenAttemp AT %IX100.1  : BOOL;  (* oven.attemp 1x1   within +/-3 degC of the station's own 150 degC -- not the pot *)
    OvenFault  AT %IX100.2  : BOOL;  (* oven.fault  1x2   element failed: TRUE = it takes your command and heats nothing *)
    PanelEstop AT %IX100.3  : BOOL;  (* panel.estop 1x3   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset AT %IX100.4  : BOOL;  (* panel.reset 1x4   Reset button, momentary: a short pulse per press *)
    PanelStart AT %IX100.5  : BOOL;  (* panel.start 1x5   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop  AT %IX100.6  : BOOL;  (* panel.stop  1x6   Stop button, momentary: a short pulse per press *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    FanAirflowHi      AT %IW100    : WORD;  (* fan.airflow      3x0   high word of FanAirflow *)
    FanAirflowLo      AT %IW101    : WORD;  (* fan.airflow      3x1   low word of FanAirflow *)
    OvenTemperatureHi AT %IW102    : WORD;  (* oven.temperature 3x2   high word of OvenTemperature *)
    OvenTemperatureLo AT %IW103    : WORD;  (* oven.temperature 3x3   low word of OvenTemperature *)
    PanelSetpointHi   AT %IW104    : WORD;  (* panel.setpoint   3x4   high word of PanelSetpoint *)
    PanelSetpointLo   AT %IW105    : WORD;  (* panel.setpoint   3x5   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    FanAirflow      : REAL;  (* fan.airflow      airflow actually delivered, % -- lags the reference, and reads 0 with the motor failed *)
    OvenTemperature : REAL;  (* oven.temperature plate temperature, degC *)
    PanelSetpoint   : REAL;  (* panel.setpoint   the operator's pot, 40..200 C (starts at 150) *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    FanSpeed        : REAL;  (* fan.speed        airflow reference, 0..100 %; the fan ramps towards it *)
    OvenHeater      : REAL;  (* oven.heater      heater power, 0..100 % *)
    TempGaugeValue  : REAL;  (* temp_gauge.value needle position, scale 0..250 C *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  FanAirflow := FF_WORDS_TO_REAL(HI := FanAirflowHi, LO := FanAirflowLo);
  OvenTemperature := FF_WORDS_TO_REAL(HI := OvenTemperatureHi, LO := OvenTemperatureLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through FanAirflow, OvenTemperature, PanelSetpoint,
     FanSpeed, OvenHeater, TempGaugeValue.

     FIRST SCANS READ FALSE. OpenPLC scans before its first Modbus poll
     returns, and until then every input reads FALSE. PanelEstop is
     normally closed, so it looks struck, and a trip latched on NOT
     PanelEstop trips itself every time OpenPLC starts. Arm the trip
     only once the E-stop has read healthy, and keep refusing Start
     while it reads FALSE (docs/OPENPLC.md, Troubleshooting):
       EstopSeen : BOOL;   in the second VAR block
       IF PanelEstop THEN EstopSeen := TRUE; END_IF;
       IF EstopSeen AND NOT PanelEstop THEN Tripped := TRUE; END_IF; *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(FanSpeed);
  FanSpeedHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  FanSpeedLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(OvenHeater);
  OvenHeaterHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  OvenHeaterLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(TempGaugeValue);
  TempGaugeValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  TempGaugeValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : cooling_tunnel;
  END_RESOURCE

END_CONFIGURATION
