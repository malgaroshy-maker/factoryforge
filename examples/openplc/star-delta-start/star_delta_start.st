(* ------------------------------------------------------------------------
   FactoryForge starter -- Star-delta starter (scene star-delta-start)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Start the motor in star -- main and star contactors -- change over to
     delta when motor.speed reaches the speed on the panel's pot, and drop
     everything on Stop. The changeover timing is yours: there is no timer
     in the starter. Star and delta closed together is a short circuit, and
     contacts close in 30 ms but take 45 ms to stop conducting, so wait for
     motor.staraux to fall before you energise delta.

   DONE WHEN
     The motor runs up in star, changes over at the pot's speed with a
     modest current step, and runs on in delta, and motor.breaker never
     drops. Drop star and energise delta in the same scan and the breaker
     trips, and stays tripped until somebody closes it by hand at the
     starter. Then load the machine (the starter's Motor Load) and start
     again: the star run-up takes about twice as long, so a changeover
     timed in seconds comes half way up it and draws nearly the direct-on-
     line current. Only motor.speed knows when the motor is ready.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               motor.delta
     0x1      1     %QX100.1               motor.main
     0x2      1     %QX100.2               motor.star
     0x3      1     %QX100.3               panel.green
     0x4      1     %QX100.4               panel.red
     0x5      1     %QX100.5               tower.green
     0x6      1     %QX100.6               tower.red
     0x7      1     %QX100.7               tower.yellow
     1x0      1     %IX100.0               motor.breaker
     1x1      1     %IX100.1               motor.deltaaux
     1x2      1     %IX100.2               motor.mainaux
     1x3      1     %IX100.3               motor.overload
     1x4      1     %IX100.4               motor.staraux
     1x5      1     %IX100.5               panel.estop
     1x6      1     %IX100.6               panel.reset
     1x7      1     %IX100.7               panel.start
     1x8      1     %IX101.0               panel.stop
     4x0      2     %QW100 + %QW101        current_gauge.value
     3x0      2     %IW100 + %IW101        motor.current
     3x2      2     %IW102 + %IW103        motor.speed
     3x4      2     %IW104 + %IW105        panel.setpoint
   ------------------------------------------------------------------------ *)

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM star_delta_start
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    MotorDelta  AT %QX100.0  : BOOL;  (* motor.delta  0x0   delta contactor coil -- NEVER with star: together they short the supply *)
    MotorMain   AT %QX100.1  : BOOL;  (* motor.main   0x1   main contactor coil: feeds the motor windings *)
    MotorStar   AT %QX100.2  : BOOL;  (* motor.star   0x2   star contactor coil: ties the winding ends together (a third of the torque) *)
    PanelGreen  AT %QX100.3  : BOOL;  (* panel.green  0x3   green lamp on the panel *)
    PanelRed    AT %QX100.4  : BOOL;  (* panel.red    0x4   red lamp on the panel *)
    TowerGreen  AT %QX100.5  : BOOL;  (* tower.green  0x5   tower lamp, green *)
    TowerRed    AT %QX100.6  : BOOL;  (* tower.red    0x6   tower lamp, red *)
    TowerYellow AT %QX100.7  : BOOL;  (* tower.yellow 0x7   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    CurrentGaugeValueHi AT %QW100    : WORD;  (* current_gauge.value 4x0   high word of CurrentGaugeValue *)
    CurrentGaugeValueLo AT %QW101    : WORD;  (* current_gauge.value 4x1   low word of CurrentGaugeValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    MotorBreaker  AT %IX100.0  : BOOL;  (* motor.breaker  1x0   motor breaker, normally closed: TRUE = closed; trips on a star-delta short and stays tripped *)
    MotorDeltaaux AT %IX100.1  : BOOL;  (* motor.deltaaux 1x1   delta contacts conducting *)
    MotorMainaux  AT %IX100.2  : BOOL;  (* motor.mainaux  1x2   main contacts conducting *)
    MotorOverload AT %IX100.3  : BOOL;  (* motor.overload 1x3   thermal overload, normally closed: TRUE = OK, FALSE = tripped *)
    MotorStaraux  AT %IX100.4  : BOOL;  (* motor.staraux  1x4   star contacts conducting -- still TRUE for 45 ms after its coil drops *)
    PanelEstop    AT %IX100.5  : BOOL;  (* panel.estop    1x5   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset    AT %IX100.6  : BOOL;  (* panel.reset    1x6   Reset button, momentary: a short pulse per press *)
    PanelStart    AT %IX100.7  : BOOL;  (* panel.start    1x7   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop     AT %IX101.0  : BOOL;  (* panel.stop     1x8   Stop button, momentary: a short pulse per press *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    MotorCurrentHi  AT %IW100    : WORD;  (* motor.current  3x0   high word of MotorCurrent *)
    MotorCurrentLo  AT %IW101    : WORD;  (* motor.current  3x1   low word of MotorCurrent *)
    MotorSpeedHi    AT %IW102    : WORD;  (* motor.speed    3x2   high word of MotorSpeed *)
    MotorSpeedLo    AT %IW103    : WORD;  (* motor.speed    3x3   low word of MotorSpeed *)
    PanelSetpointHi AT %IW104    : WORD;  (* panel.setpoint 3x4   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW105    : WORD;  (* panel.setpoint 3x5   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    MotorCurrent      : REAL;  (* motor.current  line current, A (full load 20 A) *)
    MotorSpeed        : REAL;  (* motor.speed    motor speed, % of synchronous *)
    PanelSetpoint     : REAL;  (* panel.setpoint the operator's pot, 50..95 % (starts at 85) *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    CurrentGaugeValue : REAL;  (* current_gauge.value needle position, scale 0..120 A *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  MotorCurrent := FF_WORDS_TO_REAL(HI := MotorCurrentHi, LO := MotorCurrentLo);
  MotorSpeed := FF_WORDS_TO_REAL(HI := MotorSpeedHi, LO := MotorSpeedLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through MotorCurrent, MotorSpeed, PanelSetpoint,
     CurrentGaugeValue.

     FIRST SCANS READ FALSE. OpenPLC scans before its first Modbus poll
     returns, and until then every input reads FALSE. PanelEstop is
     normally closed, so it looks struck, and a trip latched on NOT
     PanelEstop trips itself every time OpenPLC starts. Arm the trip
     only once the E-stop has read healthy, and keep refusing Start
     while it reads FALSE (docs/OPENPLC.md, Troubleshooting):
       EstopSeen : BOOL;   in the second VAR block
       IF PanelEstop THEN EstopSeen := TRUE; END_IF;
       IF EstopSeen AND NOT PanelEstop THEN Tripped := TRUE; END_IF;
     MotorBreaker and MotorOverload are normally closed too and need the
     same care. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(CurrentGaugeValue);
  CurrentGaugeValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  CurrentGaugeValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : star_delta_start;
  END_RESOURCE

END_CONFIGURATION
