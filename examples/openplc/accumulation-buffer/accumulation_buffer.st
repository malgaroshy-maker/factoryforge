(* ------------------------------------------------------------------------
   FactoryForge starter -- Accumulation buffer (scene accumulation-buffer)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Let cartons pile up behind the blade stop on a belt that never stops,
     then release a batch. Time the release by encoder pulses rather than
     by seconds: the pot is a release window in pulses, which is a
     distance.

   DONE WHEN
     Nothing gets past a raised blade while the belt keeps running, and the
     same pulse window releases the same amount of product at any drive
     speed -- turn buffer.speed up and the release takes half as long and
     lets out the same number. A timer would have let out twice as many.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               buffer.run
     0x1      1     %QX100.1               emitter.emit
     0x2      1     %QX100.2               enc.reset
     0x3      1     %QX100.3               outfeed.rotate
     0x4      1     %QX100.4               panel.green
     0x5      1     %QX100.5               panel.red
     0x6      1     %QX100.6               stop.raise
     0x7      1     %QX100.7               tower.green
     0x8      1     %QX101.0               tower.red
     0x9      1     %QX101.1               tower.yellow
     1x0      1     %IX100.0               buffer.fault
     1x1      1     %IX100.1               exit_eye.detect
     1x2      1     %IX100.2               outfeed.fault
     1x3      1     %IX100.3               panel.estop
     1x4      1     %IX100.4               panel.reset
     1x5      1     %IX100.5               panel.start
     1x6      1     %IX100.6               panel.stop
     1x7      1     %IX100.7               stop.down
     1x8      1     %IX101.0               stop.fault
     1x9      1     %IX101.1               stop.up
     4x0      2     %QW100 + %QW101        buffer.speed
     4x2      2     %QW102 + %QW103        count_display.value
     3x0      2     %IW100 + %IW101        buffer.actual
     3x2      2     %IW102 + %IW103        enc.count
     3x4      2     %IW104 + %IW105        enc.rate
     3x6      2     %IW106 + %IW107        panel.setpoint
     3x8      2     %IW108 + %IW109        released.count
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM accumulation_buffer
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    BufferRun     AT %QX100.0  : BOOL;  (* buffer.run     0x0   run the drive *)
    EmitterEmit   AT %QX100.1  : BOOL;  (* emitter.emit   0x1   rising edge = feed one carton; hold each level well over one poll *)
    EncReset      AT %QX100.2  : BOOL;  (* enc.reset      0x2   a LEVEL: held TRUE keeps the count at zero *)
    OutfeedRotate AT %QX100.3  : BOOL;  (* outfeed.rotate 0x3   run the belt *)
    PanelGreen    AT %QX100.4  : BOOL;  (* panel.green    0x4   green lamp on the panel *)
    PanelRed      AT %QX100.5  : BOOL;  (* panel.red      0x5   red lamp on the panel *)
    StopRaise     AT %QX100.6  : BOOL;  (* stop.raise     0x6   raise the blade into the lane (holds cartons on a running belt) *)
    TowerGreen    AT %QX100.7  : BOOL;  (* tower.green    0x7   tower lamp, green *)
    TowerRed      AT %QX101.0  : BOOL;  (* tower.red      0x8   tower lamp, red *)
    TowerYellow   AT %QX101.1  : BOOL;  (* tower.yellow   0x9   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    BufferSpeedHi       AT %QW100    : WORD;  (* buffer.speed        4x0   high word of BufferSpeed *)
    BufferSpeedLo       AT %QW101    : WORD;  (* buffer.speed        4x1   low word of BufferSpeed *)
    CountDisplayValueHi AT %QW102    : WORD;  (* count_display.value 4x2   high word of CountDisplayValue *)
    CountDisplayValueLo AT %QW103    : WORD;  (* count_display.value 4x3   low word of CountDisplayValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    BufferFault   AT %IX100.0  : BOOL;  (* buffer.fault    1x0   drive fault: TRUE = faulted; a faulted drive does not turn *)
    ExitEyeDetect AT %IX100.1  : BOOL;  (* exit_eye.detect 1x1   TRUE while a carton is in the beam *)
    OutfeedFault  AT %IX100.2  : BOOL;  (* outfeed.fault   1x2   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    PanelEstop    AT %IX100.3  : BOOL;  (* panel.estop     1x3   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset    AT %IX100.4  : BOOL;  (* panel.reset     1x4   Reset button, momentary: a short pulse per press *)
    PanelStart    AT %IX100.5  : BOOL;  (* panel.start     1x5   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop     AT %IX100.6  : BOOL;  (* panel.stop      1x6   Stop button, momentary: a short pulse per press *)
    StopDown      AT %IX100.7  : BOOL;  (* stop.down       1x7   blade fully down *)
    StopFault     AT %IX101.0  : BOOL;  (* stop.fault      1x8   drive fault: TRUE = faulted; the blade stays where it is *)
    StopUp        AT %IX101.1  : BOOL;  (* stop.up         1x9   blade fully up *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    BufferActualHi  AT %IW100    : WORD;  (* buffer.actual  3x0   high word of BufferActual *)
    BufferActualLo  AT %IW101    : WORD;  (* buffer.actual  3x1   low word of BufferActual *)
    EncCountHi      AT %IW102    : WORD;  (* enc.count      3x2   high word of EncCount *)
    EncCountLo      AT %IW103    : WORD;  (* enc.count      3x3   low word of EncCount *)
    EncRateHi       AT %IW104    : WORD;  (* enc.rate       3x4   high word of EncRate *)
    EncRateLo       AT %IW105    : WORD;  (* enc.rate       3x5   low word of EncRate *)
    PanelSetpointHi AT %IW106    : WORD;  (* panel.setpoint 3x6   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW107    : WORD;  (* panel.setpoint 3x7   low word of PanelSetpoint *)
    ReleasedCountHi AT %IW108    : WORD;  (* released.count 3x8   high word of ReleasedCount *)
    ReleasedCountLo AT %IW109    : WORD;  (* released.count 3x9   low word of ReleasedCount *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    BufferActual      : REAL;  (* buffer.actual  actual speed, % -- lags the reference while the drive ramps *)
    EncCount          : DINT;  (* enc.count      measuring wheel pulses, 100 per metre of belt travel *)
    EncRate           : REAL;  (* enc.rate       pulse rate, pulses/s *)
    PanelSetpoint     : REAL;  (* panel.setpoint the operator's pot, 40..300 p (starts at 120) *)
    ReleasedCount     : DINT;  (* released.count cartons this remover has taken off the line, running total *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    BufferSpeed       : REAL;  (* buffer.speed        speed reference, 0..100 % of 0.5 m/s; the drive ramps towards it *)
    CountDisplayValue : DINT;  (* count_display.value number shown on the display () *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  BufferActual := FF_WORDS_TO_REAL(HI := BufferActualHi, LO := BufferActualLo);
  EncCount := FF_WORDS_TO_DINT(HI := EncCountHi, LO := EncCountLo);
  EncRate := FF_WORDS_TO_REAL(HI := EncRateHi, LO := EncRateLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  ReleasedCount := FF_WORDS_TO_DINT(HI := ReleasedCountHi, LO := ReleasedCountLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through BufferActual, EncCount, EncRate,
     PanelSetpoint, ReleasedCount, BufferSpeed, CountDisplayValue.

     FIRST SCANS READ FALSE. OpenPLC scans before its first Modbus poll
     returns, and until then every input reads FALSE. PanelEstop is
     normally closed, so it looks struck, and a trip latched on NOT
     PanelEstop trips itself every time OpenPLC starts. Arm the trip
     only once the E-stop has read healthy, and keep refusing Start
     while it reads FALSE (docs/OPENPLC.md, Troubleshooting):
       EstopSeen : BOOL;   in the second VAR block
       IF PanelEstop THEN EstopSeen := TRUE; END_IF;
       IF EstopSeen AND NOT PanelEstop THEN Tripped := TRUE; END_IF; *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(BufferSpeed);
  BufferSpeedHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  BufferSpeedLo := DWORD_TO_WORD(Raw32);
  Raw32 := DINT_TO_DWORD(CountDisplayValue);
  CountDisplayValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  CountDisplayValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : accumulation_buffer;
  END_RESOURCE

END_CONFIGURATION
