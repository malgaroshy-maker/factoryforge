(* ------------------------------------------------------------------------
   FactoryForge starter -- Batch dosing (scene batch-dosing)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Dose the number of litres on the panel's pot into the tank, then
     transfer the batch out. Do it with two loops: an inner one that trims
     pump.speed until meter.rate is the dosing rate you want, and an outer
     one that watches meter.total and decides what that rate should be --
     full rate at first, tapering over the last few litres so the cut-off
     does not carry you past the number. Zero the totaliser before each
     batch, and remember its reset is a level, not an edge.

   DONE WHEN
     The batch lands within a litre or two of the pot, and the tank agrees:
     20 L into a 200 L tank is 10 % of level, measured by an instrument
     that is not the meter. Then halve your dosing rate and run the same
     recipe -- the same litres, in about twice the time. A batch timed in
     seconds would have delivered half. Finally fail the pump mid-dose
     (pump.fault) and watch pump.speed hold at whatever you commanded while
     meter.rate collapses: the flow loop knows within two seconds, and the
     level will not have moved a whole percent.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open:

       factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               meter.reset
     0x1      1     %QX100.1               panel.green
     0x2      1     %QX100.2               panel.red
     0x3      1     %QX100.3               pump.run
     0x4      1     %QX100.4               tower.green
     0x5      1     %QX100.5               tower.red
     0x6      1     %QX100.6               tower.yellow
     1x0      1     %IX100.0               panel.estop
     1x1      1     %IX100.1               panel.reset
     1x2      1     %IX100.2               panel.start
     1x3      1     %IX100.3               panel.stop
     1x4      1     %IX100.4               pump.fault
     1x5      1     %IX100.5               tank.fault
     4x0      2     %QW100 + %QW101        flow_gauge.value
     4x2      2     %QW102 + %QW103        level_readout.value
     4x4      2     %QW104 + %QW105        pump.speed
     4x6      2     %QW106 + %QW107        tank.drain
     4x8      2     %QW108 + %QW109        tank.fill
     4x10     2     %QW110 + %QW111        total_display.value
     3x0      2     %IW100 + %IW101        meter.rate
     3x2      2     %IW102 + %IW103        meter.total
     3x4      2     %IW104 + %IW105        panel.setpoint
     3x6      2     %IW106 + %IW107        pump.flow
     3x8      2     %IW108 + %IW109        tank.level
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM batch_dosing
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    MeterReset  AT %QX100.0  : BOOL;  (* meter.reset  0x0   a LEVEL: held TRUE keeps the total at zero *)
    PanelGreen  AT %QX100.1  : BOOL;  (* panel.green  0x1   green lamp on the panel *)
    PanelRed    AT %QX100.2  : BOOL;  (* panel.red    0x2   red lamp on the panel *)
    PumpRun     AT %QX100.3  : BOOL;  (* pump.run     0x3   run the pump *)
    TowerGreen  AT %QX100.4  : BOOL;  (* tower.green  0x4   tower lamp, green *)
    TowerRed    AT %QX100.5  : BOOL;  (* tower.red    0x5   tower lamp, red *)
    TowerYellow AT %QX100.6  : BOOL;  (* tower.yellow 0x6   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    FlowGaugeValueHi    AT %QW100    : WORD;  (* flow_gauge.value    4x0   high word of FlowGaugeValue *)
    FlowGaugeValueLo    AT %QW101    : WORD;  (* flow_gauge.value    4x1   low word of FlowGaugeValue *)
    LevelReadoutValueHi AT %QW102    : WORD;  (* level_readout.value 4x2   high word of LevelReadoutValue *)
    LevelReadoutValueLo AT %QW103    : WORD;  (* level_readout.value 4x3   low word of LevelReadoutValue *)
    PumpSpeedHi         AT %QW104    : WORD;  (* pump.speed          4x4   high word of PumpSpeed *)
    PumpSpeedLo         AT %QW105    : WORD;  (* pump.speed          4x5   low word of PumpSpeed *)
    TankDrainHi         AT %QW106    : WORD;  (* tank.drain          4x6   high word of TankDrain *)
    TankDrainLo         AT %QW107    : WORD;  (* tank.drain          4x7   low word of TankDrain *)
    TankFillHi          AT %QW108    : WORD;  (* tank.fill           4x8   high word of TankFill *)
    TankFillLo          AT %QW109    : WORD;  (* tank.fill           4x9   low word of TankFill *)
    TotalDisplayValueHi AT %QW110    : WORD;  (* total_display.value 4x10  high word of TotalDisplayValue *)
    TotalDisplayValueLo AT %QW111    : WORD;  (* total_display.value 4x11  low word of TotalDisplayValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    PanelEstop AT %IX100.0  : BOOL;  (* panel.estop 1x0   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset AT %IX100.1  : BOOL;  (* panel.reset 1x1   Reset button, momentary: a short pulse per press *)
    PanelStart AT %IX100.2  : BOOL;  (* panel.start 1x2   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop  AT %IX100.3  : BOOL;  (* panel.stop  1x3   Stop button, momentary: a short pulse per press *)
    PumpFault  AT %IX100.4  : BOOL;  (* pump.fault  1x4   motor fault: TRUE = failed; it reports your command and delivers nothing *)
    TankFault  AT %IX100.5  : BOOL;  (* tank.fault  1x5   valve fault: TRUE = a valve has seized and holds its opening, whatever you command *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    MeterRateHi     AT %IW100    : WORD;  (* meter.rate     3x0   high word of MeterRate *)
    MeterRateLo     AT %IW101    : WORD;  (* meter.rate     3x1   low word of MeterRate *)
    MeterTotalHi    AT %IW102    : WORD;  (* meter.total    3x2   high word of MeterTotal *)
    MeterTotalLo    AT %IW103    : WORD;  (* meter.total    3x3   low word of MeterTotal *)
    PanelSetpointHi AT %IW104    : WORD;  (* panel.setpoint 3x4   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW105    : WORD;  (* panel.setpoint 3x5   low word of PanelSetpoint *)
    PumpFlowHi      AT %IW106    : WORD;  (* pump.flow      3x6   high word of PumpFlow *)
    PumpFlowLo      AT %IW107    : WORD;  (* pump.flow      3x7   low word of PumpFlow *)
    TankLevelHi     AT %IW108    : WORD;  (* tank.level     3x8   high word of TankLevel *)
    TankLevelLo     AT %IW109    : WORD;  (* tank.level     3x9   low word of TankLevel *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    MeterRate         : REAL;  (* meter.rate     measured flow rate, L/min *)
    MeterTotal        : DINT;  (* meter.total    litres since the last reset, whole litres *)
    PanelSetpoint     : REAL;  (* panel.setpoint the operator's pot, 5..60 L (starts at 20) *)
    PumpFlow          : REAL;  (* pump.flow      measured flow, L/min -- the measurement, not the command *)
    TankLevel         : REAL;  (* tank.level     tank level, % of capacity *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    FlowGaugeValue    : REAL;  (* flow_gauge.value    needle position, scale 0..150 L/min *)
    LevelReadoutValue : DINT;  (* level_readout.value number shown on the display (%) *)
    PumpSpeed         : REAL;  (* pump.speed          speed reference, 0..100 % *)
    TankDrain         : REAL;  (* tank.drain          drain valve opening, 0..100 % *)
    TankFill          : REAL;  (* tank.fill           fill valve opening, 0..100 % *)
    TotalDisplayValue : DINT;  (* total_display.value number shown on the display (L) *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  MeterRate := FF_WORDS_TO_REAL(HI := MeterRateHi, LO := MeterRateLo);
  MeterTotal := FF_WORDS_TO_DINT(HI := MeterTotalHi, LO := MeterTotalLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  PumpFlow := FF_WORDS_TO_REAL(HI := PumpFlowHi, LO := PumpFlowLo);
  TankLevel := FF_WORDS_TO_REAL(HI := TankLevelHi, LO := TankLevelLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through MeterRate, MeterTotal, PanelSetpoint,
     PumpFlow, TankLevel, FlowGaugeValue, LevelReadoutValue, PumpSpeed,
     TankDrain, TankFill, TotalDisplayValue. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(FlowGaugeValue);
  FlowGaugeValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  FlowGaugeValueLo := DWORD_TO_WORD(Raw32);
  Raw32 := DINT_TO_DWORD(LevelReadoutValue);
  LevelReadoutValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  LevelReadoutValueLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(PumpSpeed);
  PumpSpeedHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  PumpSpeedLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(TankDrain);
  TankDrainHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  TankDrainLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(TankFill);
  TankFillHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  TankFillLo := DWORD_TO_WORD(Raw32);
  Raw32 := DINT_TO_DWORD(TotalDisplayValue);
  TotalDisplayValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  TotalDisplayValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : batch_dosing;
  END_RESOURCE

END_CONFIGURATION
