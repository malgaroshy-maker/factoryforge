(* ------------------------------------------------------------------------
   FactoryForge starter -- Air receiver (scene air-receiver)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     While the station runs, keep the receiver between the pot less 0.5 bar
     and the pot: open receiver.supply at the bottom of the band, close it
     at the top. receiver.pressure is the card's raw count -- 0 at 4 mA,
     27648 at 20 mA, over 0..10 bar -- so scale it (NORM_X, then SCALE_X)
     and show bar on the gauge. Open the isolation valve while the station
     runs and prove it by valve.opened: it takes 2 s to travel, and if it
     has not arrived when that and a margin have run out, it has failed --
     alarm, and stop.

   DONE WHEN
     The needle on the receiver's own gauge and the one you drive agree,
     and the receiver cycles inside the band -- still after the plant draws
     harder (the receiver's Consumption) and after you move the pot. Divide
     by 32767 instead of 27648 and everything reads 16 % low and the
     receiver runs 16 % high. Seize the valve (valve.fault) and Start:
     valve.opened never comes, and only a timer on the feedback notices --
     but a check without one alarms on every healthy start, because for two
     seconds neither limit switch is made.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open:

       factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               alarm.beacon
     0x1      1     %QX100.1               alarm.horn
     0x2      1     %QX100.2               panel.green
     0x3      1     %QX100.3               panel.red
     0x4      1     %QX100.4               receiver.supply
     0x5      1     %QX100.5               valve.open
     1x0      1     %IX100.0               panel.estop
     1x1      1     %IX100.1               panel.reset
     1x2      1     %IX100.2               panel.start
     1x3      1     %IX100.3               panel.stop
     1x4      1     %IX100.4               receiver.wirebreak
     1x5      1     %IX100.5               valve.closed
     1x6      1     %IX100.6               valve.fault
     1x7      1     %IX100.7               valve.opened
     4x0      2     %QW100 + %QW101        pressure_gauge.value
     3x0      2     %IW100 + %IW101        panel.setpoint
     3x2      2     %IW102 + %IW103        receiver.pressure
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM air_receiver
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    AlarmBeacon    AT %QX100.0  : BOOL;  (* alarm.beacon    0x0   rotating alarm beacon *)
    AlarmHorn      AT %QX100.1  : BOOL;  (* alarm.horn      0x1   alarm horn *)
    PanelGreen     AT %QX100.2  : BOOL;  (* panel.green     0x2   green lamp on the panel *)
    PanelRed       AT %QX100.3  : BOOL;  (* panel.red       0x3   red lamp on the panel *)
    ReceiverSupply AT %QX100.4  : BOOL;  (* receiver.supply 0x4   open the receiver's supply valve (load the receiver) *)
    ValveOpen      AT %QX100.5  : BOOL;  (* valve.open      0x5   energise the solenoid: the valve travels open (spring closes it when dropped) *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    PressureGaugeValueHi AT %QW100    : WORD;  (* pressure_gauge.value 4x0   high word of PressureGaugeValue *)
    PressureGaugeValueLo AT %QW101    : WORD;  (* pressure_gauge.value 4x1   low word of PressureGaugeValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    PanelEstop        AT %IX100.0  : BOOL;  (* panel.estop        1x0   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset        AT %IX100.1  : BOOL;  (* panel.reset        1x1   Reset button, momentary: a short pulse per press *)
    PanelStart        AT %IX100.2  : BOOL;  (* panel.start        1x2   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop         AT %IX100.3  : BOOL;  (* panel.stop         1x3   Stop button, momentary: a short pulse per press *)
    ReceiverWirebreak AT %IX100.4  : BOOL;  (* receiver.wirebreak 1x4   the card's wire-break diagnostic for the 4-20 mA loop *)
    ValveClosed       AT %IX100.5  : BOOL;  (* valve.closed       1x5   limit switch: valve fully closed; mid-travel neither is made (2 s end to end) *)
    ValveFault        AT %IX100.6  : BOOL;  (* valve.fault        1x6   TRUE = the stem has seized; the feedback no longer follows the command *)
    ValveOpened       AT %IX100.7  : BOOL;  (* valve.opened       1x7   limit switch: valve fully open *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    PanelSetpointHi    AT %IW100    : WORD;  (* panel.setpoint    3x0   high word of PanelSetpoint *)
    PanelSetpointLo    AT %IW101    : WORD;  (* panel.setpoint    3x1   low word of PanelSetpoint *)
    ReceiverPressureHi AT %IW102    : WORD;  (* receiver.pressure 3x2   high word of ReceiverPressure *)
    ReceiverPressureLo AT %IW103    : WORD;  (* receiver.pressure 3x3   low word of ReceiverPressure *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    PanelSetpoint      : REAL;  (* panel.setpoint    the operator's pot, 4..6.5 bar (starts at 6) *)
    ReceiverPressure   : DINT;  (* receiver.pressure receiver pressure, RAW counts: 0 = 0 bar, 27648 = 10 bar, 32767 = wire break *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    PressureGaugeValue : REAL;  (* pressure_gauge.value needle position, scale 0..10 bar *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  ReceiverPressure := FF_WORDS_TO_DINT(HI := ReceiverPressureHi, LO := ReceiverPressureLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through PanelSetpoint, ReceiverPressure,
     PressureGaugeValue. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(PressureGaugeValue);
  PressureGaugeValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  PressureGaugeValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : air_receiver;
  END_RESOURCE

END_CONFIGURATION
