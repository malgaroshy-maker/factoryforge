(* ------------------------------------------------------------------------
   FactoryForge starter -- Press station (scene press-station)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Run the press in the mode mode.position says (0 MAN, 1 OFF, 2 AUTO),
     read every scan. AUTO: from Start, stroke the ram down to the bottom-
     dead-centre switch bdc.no, hold it there for the pot's seconds, bring
     it back up, and repeat until Stop or the selector leaves AUTO. OFF:
     the ram goes up and stays up. MAN: the ram goes down only while the
     two-hand relay's hands.valid is made, and comes back up when it drops
     or at bdc.no; the next stroke needs both hands off first.

   DONE WHEN
     In AUTO the press cycles on its own; turn the selector to OFF mid-
     stroke and the ram goes straight back up, and does not come down again
     until AUTO and Start. In MAN a click on both palms together strokes
     it; click one, wait a second and click the other, and hands.left and
     hands.right both read true while hands.valid does not -- the ram must
     not move, because that is what a taped-down button looks like. Take
     your hands off mid-stroke (a single click holds for two seconds, less
     than a stroke) and the ram comes back up.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               panel.green
     0x1      1     %QX100.1               panel.red
     0x2      1     %QX100.2               ram.extend
     0x3      1     %QX100.3               ram.retract
     0x4      1     %QX100.4               tower.green
     0x5      1     %QX100.5               tower.red
     0x6      1     %QX100.6               tower.yellow
     1x0      1     %IX100.0               bdc.nc
     1x1      1     %IX100.1               bdc.no
     1x2      1     %IX100.2               hands.left
     1x3      1     %IX100.3               hands.right
     1x4      1     %IX100.4               hands.valid
     1x5      1     %IX100.5               panel.estop
     1x6      1     %IX100.6               panel.reset
     1x7      1     %IX100.7               panel.start
     1x8      1     %IX101.0               panel.stop
     1x9      1     %IX101.1               ram.extended
     1x10     1     %IX101.2               ram.fault
     1x11     1     %IX101.3               ram.retracted
     3x0      2     %IW100 + %IW101        mode.position
     3x2      2     %IW102 + %IW103        panel.setpoint
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

PROGRAM press_station
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    PanelGreen  AT %QX100.0  : BOOL;  (* panel.green  0x0   green lamp on the panel *)
    PanelRed    AT %QX100.1  : BOOL;  (* panel.red    0x1   red lamp on the panel *)
    RamExtend   AT %QX100.2  : BOOL;  (* ram.extend   0x2   extend coil (5/2 valve, no spring: the rod stays where it was last driven) *)
    RamRetract  AT %QX100.3  : BOOL;  (* ram.retract  0x3   retract coil *)
    TowerGreen  AT %QX100.4  : BOOL;  (* tower.green  0x4   tower lamp, green *)
    TowerRed    AT %QX100.5  : BOOL;  (* tower.red    0x5   tower lamp, red *)
    TowerYellow AT %QX100.6  : BOOL;  (* tower.yellow 0x6   tower lamp, yellow *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    BdcNc        AT %IX100.0  : BOOL;  (* bdc.nc        1x0   limit switch NC contact: TRUE at rest, FALSE while the lever is pushed *)
    BdcNo        AT %IX100.1  : BOOL;  (* bdc.no        1x1   limit switch NO contact: TRUE while the lever is pushed past its trip point *)
    HandsLeft    AT %IX100.2  : BOOL;  (* hands.left    1x2   left palm button held *)
    HandsRight   AT %IX100.3  : BOOL;  (* hands.right   1x3   right palm button held *)
    HandsValid   AT %IX100.4  : BOOL;  (* hands.valid   1x4   the two-hand relay's permissive: both held AND pressed within 0.5 s -- not left AND right *)
    PanelEstop   AT %IX100.5  : BOOL;  (* panel.estop   1x5   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset   AT %IX100.6  : BOOL;  (* panel.reset   1x6   Reset button, momentary: a short pulse per press *)
    PanelStart   AT %IX100.7  : BOOL;  (* panel.start   1x7   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop    AT %IX101.0  : BOOL;  (* panel.stop    1x8   Stop button, momentary: a short pulse per press *)
    RamExtended  AT %IX101.1  : BOOL;  (* ram.extended  1x9   reed switch at full stroke *)
    RamFault     AT %IX101.2  : BOOL;  (* ram.fault     1x10  TRUE = the cylinder has seized *)
    RamRetracted AT %IX101.3  : BOOL;  (* ram.retracted 1x11  reed switch at home; mid-stroke neither reed is made *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    ModePositionHi  AT %IW100    : WORD;  (* mode.position  3x0   high word of ModePosition *)
    ModePositionLo  AT %IW101    : WORD;  (* mode.position  3x1   low word of ModePosition *)
    PanelSetpointHi AT %IW102    : WORD;  (* panel.setpoint 3x2   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW103    : WORD;  (* panel.setpoint 3x3   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    ModePosition  : DINT;  (* mode.position  selector position, 0-based, in the order MAN,OFF,AUTO; it stays where it is put *)
    PanelSetpoint : REAL;  (* panel.setpoint the operator's pot, 0.5..5 s (starts at 1) *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  ModePosition := FF_WORDS_TO_DINT(HI := ModePositionHi, LO := ModePositionLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through ModePosition, PanelSetpoint. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  (* none in this scene *)

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : press_station;
  END_RESOURCE

END_CONFIGURATION
