(* ------------------------------------------------------------------------
   FactoryForge starter -- Mezzanine lift (scene mezzanine-lift)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Run both belts, and emit a carton only once the last one is aboard the
     lift, so one is on its way at a time. With the carriage at the floor
     and lift.ready made, run the carriage's deck (lift.transfer) to draw
     the carton aboard, and stop it the moment lift.occupied says the
     carton is on. Let it settle for the pot's seconds, then call the
     carriage to level 1 (lift.target := 1). Only when lift.atlevel is made
     with lift.level = 1, run the deck again to put the carton onto the
     outfeed; when out_eye sees it there, stop the deck and send the
     carriage back to level 0.

   DONE WHEN
     Every carton rides up and done.count climbs one per trip. Slow the
     hoist (the lift's Hoist Speed slider) and nothing changes but the trip
     time: a discharge timed on the rated climb runs the carton off a
     carriage still between floors, onto the mezzanine floor, and
     spill.count counts it. Leave the deck running after lift.occupied and
     the carton runs straight across the carriage and off the far side
     before it has left the floor. The lift keeps its own gate: a carton
     that arrives while the carriage is away waits on the belt, whatever
     the program does. Seize the hoist (lift.fault) between floors and
     neither level is made, and the gate stays shut.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open, in the folder FactoryForge was
     extracted to:

       .\factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     (./factoryforge-sidecar on Linux.)
     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               emitter.emit
     0x1      1     %QX100.1               infeed.rotate
     0x2      1     %QX100.2               lift.transfer
     0x3      1     %QX100.3               outfeed.rotate
     0x4      1     %QX100.4               panel.green
     0x5      1     %QX100.5               panel.red
     1x0      1     %IX100.0               gate_eye.detect
     1x1      1     %IX100.1               infeed.fault
     1x2      1     %IX100.2               lift.atlevel
     1x3      1     %IX100.3               lift.fault
     1x4      1     %IX100.4               lift.occupied
     1x5      1     %IX100.5               lift.ready
     1x6      1     %IX100.6               out_eye.detect
     1x7      1     %IX100.7               outfeed.fault
     1x8      1     %IX101.0               panel.estop
     1x9      1     %IX101.1               panel.reset
     1x10     1     %IX101.2               panel.start
     1x11     1     %IX101.3               panel.stop
     4x0      2     %QW100 + %QW101        lift.target
     3x0      2     %IW100 + %IW101        done.count
     3x2      2     %IW102 + %IW103        lift.height
     3x4      2     %IW104 + %IW105        lift.level
     3x6      2     %IW106 + %IW107        panel.setpoint
     3x8      2     %IW108 + %IW109        spill.count
   ------------------------------------------------------------------------ *)

(* The sidecar sends a 32-bit value as two registers, high word first
   (struct.pack(">i") in drivers/modbus_tcp.py). DWORD_TO_DINT reinterprets
   the bit pattern, so this is right for negative values too. *)
FUNCTION FF_WORDS_TO_DINT : DINT
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  FF_WORDS_TO_DINT := DWORD_TO_DINT(SHL(IN := WORD_TO_DWORD(HI), N := 16)
                                    OR WORD_TO_DWORD(LO));
END_FUNCTION

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

PROGRAM mezzanine_lift
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    EmitterEmit   AT %QX100.0  : BOOL;  (* emitter.emit   0x0   rising edge = feed one carton; hold each level well over one poll *)
    InfeedRotate  AT %QX100.1  : BOOL;  (* infeed.rotate  0x1   run the belt *)
    LiftTransfer  AT %QX100.2  : BOOL;  (* lift.transfer  0x2   run the carriage's deck along the line -- how a carton gets on, and how it gets off *)
    OutfeedRotate AT %QX100.3  : BOOL;  (* outfeed.rotate 0x3   run the belt *)
    PanelGreen    AT %QX100.4  : BOOL;  (* panel.green    0x4   green lamp on the panel *)
    PanelRed      AT %QX100.5  : BOOL;  (* panel.red      0x5   red lamp on the panel *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    LiftTargetHi AT %QW100    : WORD;  (* lift.target 4x0   high word of LiftTarget *)
    LiftTargetLo AT %QW101    : WORD;  (* lift.target 4x1   low word of LiftTarget *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    GateEyeDetect AT %IX100.0  : BOOL;  (* gate_eye.detect 1x0   TRUE while anything breaks the beam to the reflector *)
    InfeedFault   AT %IX100.1  : BOOL;  (* infeed.fault    1x1   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    LiftAtlevel   AT %IX100.2  : BOOL;  (* lift.atlevel    1x2   carriage at the level it is called to, within 0.02 m -- stale on the scan you change the call *)
    LiftFault     AT %IX100.3  : BOOL;  (* lift.fault      1x3   hoist fault: TRUE = seized where it stands, between floors if that is where it was; the gate stays shut *)
    LiftOccupied  AT %IX100.4  : BOOL;  (* lift.occupied   1x4   a carton is aboard: its centre is over the middle of the deck *)
    LiftReady     AT %IX100.5  : BOOL;  (* lift.ready      1x5   carriage empty at the infeed level with its entry gate down -- a carton may come aboard *)
    OutEyeDetect  AT %IX100.6  : BOOL;  (* out_eye.detect  1x6   TRUE while anything breaks the beam to the reflector *)
    OutfeedFault  AT %IX100.7  : BOOL;  (* outfeed.fault   1x7   drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told *)
    PanelEstop    AT %IX101.0  : BOOL;  (* panel.estop     1x8   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset    AT %IX101.1  : BOOL;  (* panel.reset     1x9   Reset button, momentary: a short pulse per press *)
    PanelStart    AT %IX101.2  : BOOL;  (* panel.start     1x10  Start button, momentary: a short pulse per press -- latch it *)
    PanelStop     AT %IX101.3  : BOOL;  (* panel.stop      1x11  Stop button, momentary: a short pulse per press *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    DoneCountHi     AT %IW100    : WORD;  (* done.count     3x0   high word of DoneCount *)
    DoneCountLo     AT %IW101    : WORD;  (* done.count     3x1   low word of DoneCount *)
    LiftHeightHi    AT %IW102    : WORD;  (* lift.height    3x2   high word of LiftHeight *)
    LiftHeightLo    AT %IW103    : WORD;  (* lift.height    3x3   low word of LiftHeight *)
    LiftLevelHi     AT %IW104    : WORD;  (* lift.level     3x4   high word of LiftLevel *)
    LiftLevelLo     AT %IW105    : WORD;  (* lift.level     3x5   low word of LiftLevel *)
    PanelSetpointHi AT %IW106    : WORD;  (* panel.setpoint 3x6   high word of PanelSetpoint *)
    PanelSetpointLo AT %IW107    : WORD;  (* panel.setpoint 3x7   low word of PanelSetpoint *)
    SpillCountHi    AT %IW108    : WORD;  (* spill.count    3x8   high word of SpillCount *)
    SpillCountLo    AT %IW109    : WORD;  (* spill.count    3x9   low word of SpillCount *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    DoneCount     : DINT;  (* done.count     cartons delivered to the far end of the mezzanine outfeed, running total *)
    LiftHeight    : REAL;  (* lift.height    carriage height above its lowest level, m *)
    LiftLevel     : DINT;  (* lift.level     the level the carriage is nearest (not that it has arrived: see atlevel) *)
    PanelSetpoint : REAL;  (* panel.setpoint the operator's pot, 0.5..3 s (starts at 1) *)
    SpillCount    : DINT;  (* spill.count    cartons that fell onto the mezzanine floor -- run off the carriage between floors -- running total *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    LiftTarget    : DINT;  (* lift.target call the carriage to a level: 0 = the floor; 2 levels, 0.9 m apart *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  DoneCount := FF_WORDS_TO_DINT(HI := DoneCountHi, LO := DoneCountLo);
  LiftHeight := FF_WORDS_TO_REAL(HI := LiftHeightHi, LO := LiftHeightLo);
  LiftLevel := FF_WORDS_TO_DINT(HI := LiftLevelHi, LO := LiftLevelLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);
  SpillCount := FF_WORDS_TO_DINT(HI := SpillCountHi, LO := SpillCountLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through DoneCount, LiftHeight, LiftLevel,
     PanelSetpoint, SpillCount, LiftTarget. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := DINT_TO_DWORD(LiftTarget);
  LiftTargetHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  LiftTargetLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : mezzanine_lift;
  END_RESOURCE

END_CONFIGURATION
