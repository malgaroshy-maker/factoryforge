(* ------------------------------------------------------------------------
   FactoryForge starter -- Heat treat station (scene heat-treat-station)
   OpenPLC Runtime v3, IEC 61131-3 Structured Text, over Modbus TCP.
   Generated by tools/gen_starters.py from the scene's tag set; see README.md
   beside this file. Write your program in section 2 below.

   THE TASK
     Hold the plate at the temperature on the panel's pot. The plant is a
     first-order lag with a loss to ambient, so holding a temperature needs
     a standing output -- and proportional control can only make one out of
     a standing error.

   DONE WHEN
     With proportional gain alone the plate parks visibly short of setpoint
     -- measure that offset. Add integral action and it closes. Then fail
     the element (oven.fault) and watch oven.heater keep reading what you
     commanded while the temperature falls: the output tells you nothing,
     only the measurement does.

   HOW IT IS WIRED
     FactoryForge is the Modbus slave; OpenPLC is the master and polls it.
     mbconfig.cfg beside this file is that Slave Device. The addresses
     below are the ones the sidecar serves for this scene when it is
     started AFTER the scene is open:

       factoryforge-sidecar connect --driver modbus-tcp -o port 5502

     It prints its address map on startup; that map is the authority, and
     the table below must match it line for line. Change scene and the
     sidecar keeps every address it has handed out and puts new tags above
     them -- restart it after changing scene.

     OpenPLC numbers each block it polls from 100: slave coil n is
     %QX(100 + n/8).(n mod 8), slave input register n is %IW(100 + n).

     An INT or REAL tag is 32 bits and takes TWO registers, high word
     first. Section 1 rebuilds the inputs and section 3 splits the outputs;
     your program works with the plain DINT and REAL variables.

     In the sidecar's order (block, then address; addresses are decimal):

     MODBUS   REGS  OPENPLC                TAG
     0x0      1     %QX100.0               alarm.beacon
     0x1      1     %QX100.1               alarm.horn
     0x2      1     %QX100.2               panel.green
     0x3      1     %QX100.3               panel.red
     0x4      1     %QX100.4               tower.green
     0x5      1     %QX100.5               tower.red
     0x6      1     %QX100.6               tower.yellow
     1x0      1     %IX100.0               oven.attemp
     1x1      1     %IX100.1               oven.fault
     1x2      1     %IX100.2               panel.estop
     1x3      1     %IX100.3               panel.reset
     1x4      1     %IX100.4               panel.start
     1x5      1     %IX100.5               panel.stop
     4x0      2     %QW100 + %QW101        oven.heater
     4x2      2     %QW102 + %QW103        temp_gauge.value
     4x4      2     %QW104 + %QW105        temp_readout.value
     3x0      2     %IW100 + %IW101        oven.temperature
     3x2      2     %IW102 + %IW103        panel.setpoint
   ------------------------------------------------------------------------ *)

(* A REAL arrives the same way: IEEE-754 single precision, high word first.
   OpenPLC's DWORD_TO_REAL cannot rebuild it -- it converts the NUMBER, so
   16#3F800000 becomes 1065353216.0 rather than 1.0 -- so this takes the
   sign, exponent and mantissa apart by hand. Exact for every normal value;
   zero and the tiny subnormals (below 1.2E-38) come back as 0.0. *)
FUNCTION FF_WORDS_TO_REAL : REAL
  VAR_INPUT
    HI : WORD;
    LO : WORD;
  END_VAR
  VAR
    Exponent : INT;
    Value    : REAL;
  END_VAR
  Exponent := WORD_TO_INT(SHR(IN := HI, N := 7) AND 16#00FF);
  IF Exponent = 0 OR Exponent = 255 THEN
    Value := 0.0;
  ELSE
    Value := 1.0 + DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD(HI AND 16#007F), N := 16)
                                 OR WORD_TO_DWORD(LO)) / 8388608.0;
    Exponent := Exponent - 127;
    WHILE Exponent > 0 DO
      Value := Value * 2.0;
      Exponent := Exponent - 1;
    END_WHILE;
    WHILE Exponent < 0 DO
      Value := Value / 2.0;
      Exponent := Exponent + 1;
    END_WHILE;
    IF (HI AND 16#8000) <> 0 THEN
      Value := -Value;
    END_IF;
  END_IF;
  FF_WORDS_TO_REAL := Value;
END_FUNCTION

(* The other direction: a REAL as the 32 bits IEEE-754 gives it, for
   splitting into two registers. REAL_TO_DWORD cannot do this either (it
   rounds the number). Exact for every normal value; anything smaller than
   1.2E-38 is sent as zero. *)
FUNCTION FF_REAL_TO_DWORD : DWORD
  VAR_INPUT
    IN : REAL;
  END_VAR
  VAR
    Magnitude : REAL;
    Exponent  : INT;
    Sign      : DWORD;
  END_VAR
  Sign := 0;
  Magnitude := IN;
  IF Magnitude < 0.0 THEN
    Sign := 16#80000000;
    Magnitude := -Magnitude;
  END_IF;
  Exponent := 127;
  WHILE Magnitude >= 2.0 AND Exponent < 254 DO
    Magnitude := Magnitude / 2.0;
    Exponent := Exponent + 1;
  END_WHILE;
  WHILE Magnitude < 1.0 AND Exponent > 1 DO
    Magnitude := Magnitude * 2.0;
    Exponent := Exponent - 1;
  END_WHILE;
  IF Magnitude < 1.0 THEN
    FF_REAL_TO_DWORD := Sign;
  ELSIF Magnitude >= 2.0 THEN
    FF_REAL_TO_DWORD := Sign OR 16#7F7FFFFF;
  ELSE
    FF_REAL_TO_DWORD := Sign
                        OR SHL(IN := INT_TO_DWORD(Exponent), N := 23)
                        OR REAL_TO_DWORD((Magnitude - 1.0) * 8388608.0);
  END_IF;
END_FUNCTION

PROGRAM heat_treat_station
  VAR
    (* --- PLC writes: coils --------------------------------------------- *)
    AlarmBeacon AT %QX100.0  : BOOL;  (* alarm.beacon 0x0   rotating alarm beacon *)
    AlarmHorn   AT %QX100.1  : BOOL;  (* alarm.horn   0x1   alarm horn *)
    PanelGreen  AT %QX100.2  : BOOL;  (* panel.green  0x2   green lamp on the panel *)
    PanelRed    AT %QX100.3  : BOOL;  (* panel.red    0x3   red lamp on the panel *)
    TowerGreen  AT %QX100.4  : BOOL;  (* tower.green  0x4   tower lamp, green *)
    TowerRed    AT %QX100.5  : BOOL;  (* tower.red    0x5   tower lamp, red *)
    TowerYellow AT %QX100.6  : BOOL;  (* tower.yellow 0x6   tower lamp, yellow *)
    (* --- PLC writes: holding registers, two per value ------------------ *)
    OvenHeaterHi       AT %QW100    : WORD;  (* oven.heater        4x0   high word of OvenHeater *)
    OvenHeaterLo       AT %QW101    : WORD;  (* oven.heater        4x1   low word of OvenHeater *)
    TempGaugeValueHi   AT %QW102    : WORD;  (* temp_gauge.value   4x2   high word of TempGaugeValue *)
    TempGaugeValueLo   AT %QW103    : WORD;  (* temp_gauge.value   4x3   low word of TempGaugeValue *)
    TempReadoutValueHi AT %QW104    : WORD;  (* temp_readout.value 4x4   high word of TempReadoutValue *)
    TempReadoutValueLo AT %QW105    : WORD;  (* temp_readout.value 4x5   low word of TempReadoutValue *)
    (* --- PLC reads: discrete inputs ------------------------------------ *)
    OvenAttemp AT %IX100.0  : BOOL;  (* oven.attemp 1x0   within +/-3 degC of the station's own 180 degC -- not the pot *)
    OvenFault  AT %IX100.1  : BOOL;  (* oven.fault  1x1   element failed: TRUE = it takes your command and heats nothing *)
    PanelEstop AT %IX100.2  : BOOL;  (* panel.estop 1x2   E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out *)
    PanelReset AT %IX100.3  : BOOL;  (* panel.reset 1x3   Reset button, momentary: a short pulse per press *)
    PanelStart AT %IX100.4  : BOOL;  (* panel.start 1x4   Start button, momentary: a short pulse per press -- latch it *)
    PanelStop  AT %IX100.5  : BOOL;  (* panel.stop  1x5   Stop button, momentary: a short pulse per press *)
    (* --- PLC reads: input registers, two per value --------------------- *)
    OvenTemperatureHi AT %IW100    : WORD;  (* oven.temperature 3x0   high word of OvenTemperature *)
    OvenTemperatureLo AT %IW101    : WORD;  (* oven.temperature 3x1   low word of OvenTemperature *)
    PanelSetpointHi   AT %IW102    : WORD;  (* panel.setpoint   3x2   high word of PanelSetpoint *)
    PanelSetpointLo   AT %IW103    : WORD;  (* panel.setpoint   3x3   low word of PanelSetpoint *)
  END_VAR

  (* A second VAR block, and not for tidiness: matiec will not mix located
     and unlocated declarations in one. Your own variables go here too. *)
  VAR
    (* --- PLC reads, in engineering units ---------------------------------- *)
    OvenTemperature  : REAL;  (* oven.temperature plate temperature, degC *)
    PanelSetpoint    : REAL;  (* panel.setpoint   the operator's pot, 20..280 C (starts at 180) *)
    (* --- PLC writes, in engineering units ---------------------------------- *)
    OvenHeater       : REAL;  (* oven.heater        heater power, 0..100 % *)
    TempGaugeValue   : REAL;  (* temp_gauge.value   needle position, scale 0..300 C *)
    TempReadoutValue : DINT;  (* temp_readout.value number shown on the display (C) *)
    Raw32 : DWORD;  (* scratch for splitting a 32-bit output *)
  END_VAR

  (* ===== 1. Inputs: rebuild each 32-bit value from its two registers ===== *)
  OvenTemperature := FF_WORDS_TO_REAL(HI := OvenTemperatureHi, LO := OvenTemperatureLo);
  PanelSetpoint := FF_WORDS_TO_REAL(HI := PanelSetpointHi, LO := PanelSetpointLo);

  (* ===== 2. Your program ================================================
     The task is at the top of this file and in the scene's Task panel.
     Every signal above can be used by name here: the bits directly, the
     32-bit values through OvenTemperature, PanelSetpoint, OvenHeater,
     TempGaugeValue, TempReadoutValue. *)

  (* ===== 3. Outputs: split each 32-bit value into its two registers ===== *)
  Raw32 := FF_REAL_TO_DWORD(OvenHeater);
  OvenHeaterHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  OvenHeaterLo := DWORD_TO_WORD(Raw32);
  Raw32 := FF_REAL_TO_DWORD(TempGaugeValue);
  TempGaugeValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  TempGaugeValueLo := DWORD_TO_WORD(Raw32);
  Raw32 := DINT_TO_DWORD(TempReadoutValue);
  TempReadoutValueHi := DWORD_TO_WORD(SHR(IN := Raw32, N := 16));
  TempReadoutValueLo := DWORD_TO_WORD(Raw32);

END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    (* 20 ms, as in examples/openplc/Sorting.st: every scan spent waiting
       comes out of the scene's timing margins. *)
    TASK Main(INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : heat_treat_station;
  END_RESOURCE

END_CONFIGURATION
