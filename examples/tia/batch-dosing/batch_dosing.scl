DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      FlowGaugeValue : Real;    // flow_gauge.value (PLC writes) needle position, scale 0..150 L/min
      LevelReadoutValue : DInt; // level_readout.value (PLC writes) number shown on the display (%)
      PumpSpeed : Real;         // pump.speed (PLC writes) speed reference, 0..100 %
      TankDrain : Real;         // tank.drain (PLC writes) drain valve opening, 0..100 %
      TankFill : Real;          // tank.fill (PLC writes) fill valve opening, 0..100 %
      TotalDisplayValue : DInt; // total_display.value (PLC writes) number shown on the display (L)
      MeterReset : Bool;        // meter.reset (PLC writes) a LEVEL: held TRUE keeps the total at zero
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      PumpRun : Bool;           // pump.run (PLC writes) run the pump
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      MeterRate : Real;         // meter.rate (PLC reads) measured flow rate, L/min
      MeterTotal : DInt;        // meter.total (PLC reads) litres since the last reset, whole litres
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 5..60 L (starts at 20)
      PumpFlow : Real;          // pump.flow (PLC reads) measured flow, L/min -- the measurement, not the command
      TankLevel : Real;         // tank.level (PLC reads) tank level, % of capacity
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      PumpFault : Bool;         // pump.fault (PLC reads) motor fault: TRUE = failed; it reports your command and delivers nothing
      TankFault : Bool;         // tank.fault (PLC reads) valve fault: TRUE = a valve has seized and holds its opening, whatever you command
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "BatchDosing"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Batch dosing (scene batch-dosing)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Dose the number of litres on the panel's pot into the tank, then
//   transfer the batch out. Do it with two loops: an inner one that trims
//   pump.speed until meter.rate is the dosing rate you want, and an outer
//   one that watches meter.total and decides what that rate should be --
//   full rate at first, tapering over the last few litres so the cut-off
//   does not carry you past the number. Zero the totaliser before each
//   batch, and remember its reset is a level, not an edge.
//
// DONE WHEN
//   The batch lands within a litre or two of the pot, and the tank agrees:
//   20 L into a 200 L tank is 10 % of level, measured by an instrument
//   that is not the meter. Then halve your dosing rate and run the same
//   recipe -- the same litres, in about twice the time. A batch timed in
//   seconds would have delivered half. Finally fail the pump mid-dose
//   (pump.fault) and watch pump.speed hold at whatever you commanded while
//   meter.rate collapses: the flow loop knows within two seconds, and the
//   level will not have moved a whole percent. Drop pump.run within those
//   two seconds, and do not dose again by yourself when the pump comes
//   back: a dose that ended on a fault waits for Reset and Start. The
//   mushroom (panel.estop, normally closed) stops the pump within 200 ms
//   and its trip latches: releasing it restarts nothing, and neither does
//   Start or Reset alone -- only Reset, then Start.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".FlowGaugeValue. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
