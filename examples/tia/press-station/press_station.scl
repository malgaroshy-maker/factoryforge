DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      PanelGreen : Bool;    // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;      // panel.red (PLC writes) red lamp on the panel
      RamExtend : Bool;     // ram.extend (PLC writes) extend coil (5/2 valve, no spring: the rod stays where it was last driven)
      RamRetract : Bool;    // ram.retract (PLC writes) retract coil
      TowerGreen : Bool;    // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;      // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;   // tower.yellow (PLC writes) tower lamp, yellow
      ModePosition : DInt;  // mode.position (PLC reads) selector position, 0-based, in the order MAN,OFF,AUTO; it stays where it is put
      PanelSetpoint : Real; // panel.setpoint (PLC reads) the operator's pot, 0.5..5 s (starts at 1)
      BdcNc : Bool;         // bdc.nc (PLC reads) limit switch NC contact: TRUE at rest, FALSE while the lever is pushed
      BdcNo : Bool;         // bdc.no (PLC reads) limit switch NO contact: TRUE while the lever is pushed past its trip point
      HandsLeft : Bool;     // hands.left (PLC reads) left palm button held
      HandsRight : Bool;    // hands.right (PLC reads) right palm button held
      HandsValid : Bool;    // hands.valid (PLC reads) the two-hand relay's permissive: both held AND pressed within 0.5 s -- not left AND right
      PanelEstop : Bool;    // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;    // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;    // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;     // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      RamExtended : Bool;   // ram.extended (PLC reads) reed switch at full stroke
      RamFault : Bool;      // ram.fault (PLC reads) TRUE = the cylinder has seized
      RamRetracted : Bool;  // ram.retracted (PLC reads) reed switch at home; mid-stroke neither reed is made
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "PressStation"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Press station (scene press-station)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Run the press in the mode mode.position says (0 MAN, 1 OFF, 2 AUTO),
//   read every scan. AUTO: from Start, stroke the ram down to the bottom-
//   dead-centre switch bdc.no, hold it there for the pot's seconds, bring
//   it back up, and repeat until Stop or the selector leaves AUTO. OFF:
//   the ram goes up and stays up. MAN: the ram goes down only while the
//   two-hand relay's hands.valid is made, and comes back up when it drops
//   or at bdc.no; the next stroke needs both hands off first.
//
// DONE WHEN
//   In AUTO the press cycles on its own; turn the selector to OFF mid-
//   stroke and the ram goes straight back up, and does not come down again
//   until AUTO and Start. In MAN a click on both palms together strokes
//   it; click one, wait a second and click the other, and hands.left and
//   hands.right both read true while hands.valid does not -- the ram must
//   not move, because that is what a taped-down button looks like. Take
//   your hands off mid-stroke (a single click holds for two seconds, less
//   than a stroke) and the ram comes back up. The mushroom (panel.estop,
//   normally closed) stops the ram's down-stroke in any mode within 200 ms
//   and its trip latches: releasing it restarts nothing, and neither does
//   Start or Reset alone -- only Reset, then Start.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".PanelGreen. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
