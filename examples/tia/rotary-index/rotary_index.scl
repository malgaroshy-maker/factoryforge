DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      EmitterEmit : Bool;     // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      OutfeedRotate : Bool;   // outfeed.rotate (PLC writes) run the belt
      PanelGreen : Bool;      // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;        // panel.red (PLC writes) red lamp on the panel
      PusherExtend : Bool;    // pusher.extend (PLC writes) extend coil (5/2 valve, no spring: the rod stays where it was last driven)
      PusherRetract : Bool;   // pusher.retract (PLC writes) retract coil
      TableIndex : Bool;      // table.index (PLC writes) turn the deck to its index angle; FALSE turns it home
      TowerGreen : Bool;      // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;        // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;     // tower.yellow (PLC writes) tower lamp, yellow
      DoneCount : DInt;       // done.count (PLC reads) cartons this remover has taken off the line, running total
      PanelSetpoint : Real;   // panel.setpoint (PLC reads) the operator's pot, 0.5..3 s (starts at 1)
      DeckEyeDetect : Bool;   // deck_eye.detect (PLC reads) TRUE while anything breaks the beam to the reflector
      OutfeedFault : Bool;    // outfeed.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      PanelEstop : Bool;      // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;      // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;      // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;       // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      PusherExtended : Bool;  // pusher.extended (PLC reads) reed switch at full stroke
      PusherFault : Bool;     // pusher.fault (PLC reads) TRUE = the cylinder has seized
      PusherRetracted : Bool; // pusher.retracted (PLC reads) reed switch at home; mid-stroke neither reed is made
      TableAthome : Bool;     // table.athome (PLC reads) deck square at home
      TableAtindex : Bool;    // table.atindex (PLC reads) deck square at its 90 deg index; between the two neither is made
      TableFault : Bool;      // table.fault (PLC reads) TRUE = the deck has seized where it is
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "RotaryIndex"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Rotary index station (scene rotary-index)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   With the deck home, the rod back and deck_eye clear, drop a carton on
//   the deck (emitter.emit), let it settle for the pot's seconds, and turn
//   the deck a quarter (table.index). When table.atindex is made, sweep
//   the carton onto the running outfeed with the cylinder -- two coils,
//   two reeds -- and only once pusher.retracted is made turn the deck home
//   again. The deck has no rollers: the only way on is the emitter and the
//   only way off is the pusher.
//
// DONE WHEN
//   Every carton leaves the deck turned a quarter and done.count climbs
//   one per cycle. Then slow the deck (the turntable's Index Speed) and
//   nothing changes but the cycle time: a push timed on the rated quarter
//   turn meets the carton half way round. Turn the deck home the moment
//   pusher.extended drops and the rod is still out over it -- between its
//   two reeds a cylinder is neither extended nor retracted. Seize the deck
//   (table.fault) mid-turn and neither limit switch is made.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".EmitterEmit. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
