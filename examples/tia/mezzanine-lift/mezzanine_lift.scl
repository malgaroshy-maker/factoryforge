DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      LiftTarget : DInt;    // lift.target (PLC writes) call the carriage to a level: 0 = the floor; 2 levels, 0.9 m apart
      EmitterEmit : Bool;   // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      InfeedRotate : Bool;  // infeed.rotate (PLC writes) run the belt
      LiftTransfer : Bool;  // lift.transfer (PLC writes) run the carriage's deck along the line -- how a carton gets on, and how it gets off
      OutfeedRotate : Bool; // outfeed.rotate (PLC writes) run the belt
      PanelGreen : Bool;    // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;      // panel.red (PLC writes) red lamp on the panel
      DoneCount : DInt;     // done.count (PLC reads) cartons delivered to the far end of the mezzanine outfeed, running total
      LiftHeight : Real;    // lift.height (PLC reads) carriage height above its lowest level, m
      LiftLevel : DInt;     // lift.level (PLC reads) the level the carriage is nearest (not that it has arrived: see atlevel)
      PanelSetpoint : Real; // panel.setpoint (PLC reads) the operator's pot, 0.5..3 s (starts at 1)
      SpillCount : DInt;    // spill.count (PLC reads) cartons that fell onto the mezzanine floor -- run off the carriage between floors -- running total
      GateEyeDetect : Bool; // gate_eye.detect (PLC reads) TRUE while anything breaks the beam to the reflector
      InfeedFault : Bool;   // infeed.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      LiftAtlevel : Bool;   // lift.atlevel (PLC reads) carriage at the level it is called to, within 0.02 m -- stale on the scan you change the call
      LiftFault : Bool;     // lift.fault (PLC reads) hoist fault: TRUE = seized where it stands, between floors if that is where it was; the gate stays shut
      LiftOccupied : Bool;  // lift.occupied (PLC reads) a carton is aboard: its centre is over the middle of the deck
      LiftReady : Bool;     // lift.ready (PLC reads) carriage empty at the infeed level with its entry gate down -- a carton may come aboard
      OutEyeDetect : Bool;  // out_eye.detect (PLC reads) TRUE while anything breaks the beam to the reflector
      OutfeedFault : Bool;  // outfeed.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      PanelEstop : Bool;    // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;    // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;    // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;     // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "MezzanineLift"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Mezzanine lift (scene mezzanine-lift)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Run both belts, and emit a carton only once the last one is aboard the
//   lift, so one is on its way at a time. With the carriage at the floor
//   and lift.ready made, run the carriage's deck (lift.transfer) to draw
//   the carton aboard, and stop it the moment lift.occupied says the
//   carton is on. Let it settle for the pot's seconds, then call the
//   carriage to level 1 (lift.target := 1). Only when lift.atlevel is made
//   with lift.level = 1, run the deck again to put the carton onto the
//   outfeed; when out_eye sees it there, stop the deck and send the
//   carriage back to level 0.
//
// DONE WHEN
//   Every carton rides up and done.count climbs one per trip. Slow the
//   hoist (the lift's Hoist Speed slider) and nothing changes but the trip
//   time: a discharge timed on the rated climb runs the carton off a
//   carriage still between floors, onto the mezzanine floor, and
//   spill.count counts it. Leave the deck running after lift.occupied and
//   the carton runs straight across the carriage and off the far side
//   before it has left the floor. The lift keeps its own gate: a carton
//   that arrives while the carriage is away waits on the belt, whatever
//   the program does. Seize the hoist (lift.fault) between floors and
//   neither level is made, and the gate stays shut.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".LiftTarget. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
