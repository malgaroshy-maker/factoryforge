DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      ProducedValue : DInt;     // produced.value (PLC writes) number shown on the display (pcs)
      BeltRotate : Bool;        // belt.rotate (PLC writes) run the belt
      EmitterEmit : Bool;       // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      CounterCount : DInt;      // counter.count (PLC reads) cartons this remover has taken off the line, running total
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 0..50 pcs (starts at 12)
      BeltFault : Bool;         // belt.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      PartPresentDetect : Bool; // part_present.detect (PLC reads) TRUE while a carton is in the beam
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "StartStopStation"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Start / stop station (scene start-stop-station)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   The operator contract, on its own. Start runs the belt, Stop stops it,
//   and the mushroom latches a trip that only Reset clears. Feed a batch
//   of the size the panel's pot asks for and stop when it is made.
//
// DONE WHEN
//   The batch count reaches the setpoint and the line stops itself.
//   Pressing Start while tripped does nothing; releasing the mushroom does
//   not restart it either. Only Reset then Start brings it back.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".ProducedValue. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
