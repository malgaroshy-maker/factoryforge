DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      LevelReadoutValue : DInt; // level_readout.value (PLC writes) number shown on the display (%)
      TankDrain : Real;         // tank.drain (PLC writes) drain valve opening, 0..100 %
      TankFill : Real;          // tank.fill (PLC writes) fill valve opening, 0..100 %
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 0..100 % (starts at 70)
      TankLevel : Real;         // tank.level (PLC reads) tank level, % of capacity
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      TankFault : Bool;         // tank.fault (PLC reads) valve fault: TRUE = a valve has seized and holds its opening, whatever you command
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "TankLevelControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Tank level control (scene tank-level-control)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Hold the tank at the level the panel's pot asks for, using the fill
//   and drain valves. Outflow follows Torricelli, so the process gain
//   changes with level: a controller tuned at the top overshoots at the
//   bottom.
//
// DONE WHEN
//   The level settles within a few percent of the setpoint and holds
//   there, and it still settles after you move the pot to a different
//   level. A seized valve (tank.fault) keeps its opening while your
//   command reads zero.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".LevelReadoutValue. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
