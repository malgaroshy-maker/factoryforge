DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      BeltRotate : Bool;         // belt.rotate (PLC writes) run the belt
      DiverterExtend : Bool;     // diverter.extend (PLC writes) extend the pusher
      EmitterEmit : Bool;        // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      PanelGreen : Bool;         // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;           // panel.red (PLC writes) red lamp on the panel
      HeightGaugeHeight : Real;  // height_gauge.height (PLC reads) light curtain: height of the tallest blocked beam, m (0 when clear)
      PanelSetpoint : Real;      // panel.setpoint (PLC reads) the operator's pot, 0..0.5 m (starts at 0.15)
      ShortCountCount : DInt;    // short_count.count (PLC reads) cartons this remover has taken off the line, running total
      TallCountCount : DInt;     // tall_count.count (PLC reads) cartons this remover has taken off the line, running total
      BeltFault : Bool;          // belt.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      DiverterExtended : Bool;   // diverter.extended (PLC reads) pusher fully out
      DiverterFault : Bool;      // diverter.fault (PLC reads) drive fault: TRUE = jammed; it freezes where it is
      DiverterRetracted : Bool;  // diverter.retracted (PLC reads) pusher fully back
      HeightGaugeBlocked : Bool; // height_gauge.blocked (PLC reads) light curtain: TRUE while any beam is blocked
      PanelEstop : Bool;         // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;         // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;         // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;          // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "LightCurtainSorting"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Light curtain sorting (scene light-curtain-sorting)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Sort on a measurement rather than on two bits. The curtain reports how
//   tall each carton is, in metres, so the threshold is yours to choose --
//   put it on the panel's pot and you can change your mind without editing
//   the program.
//
// DONE WHEN
//   Cartons above your threshold go down the chute and the rest pass, and
//   moving the pot moves the boundary with no other change. The two
//   counters together equal what the curtain measured.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".BeltRotate. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
