DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      GantryTarget : Real;      // gantry.target (PLC writes) rail position to travel to, 0..100 % of the 2.4 m rail
      InfeedSpeed : Real;       // infeed.speed (PLC writes) speed reference, 0..100 % of 0.8 m/s; the drive ramps towards it
      RateValue : Real;         // rate.value (PLC writes) needle position, scale 0..100 %
      AlarmBeacon : Bool;       // alarm.beacon (PLC writes) rotating alarm beacon
      AlarmHorn : Bool;         // alarm.horn (PLC writes) alarm horn
      EmitterEmit : Bool;       // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll; every 4th carton is steel
      GantryGrip : Bool;        // gantry.grip (PLC writes) vacuum on
      GantryLower : Bool;       // gantry.lower (PLC writes) lower the cup (FALSE raises it)
      InfeedRun : Bool;         // infeed.run (PLC writes) run the drive
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      PickstationRotate : Bool; // pickstation.rotate (PLC writes) run the belt
      ScannerEnable : Bool;     // scanner.enable (PLC writes) arm the reader; FALSE switches it off -- and an output you never write is FALSE
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      GantryPosition : Real;    // gantry.position (PLC reads) rail position now, 0..100 %
      InfeedActual : Real;      // infeed.actual (PLC reads) actual speed, % -- lags the reference while the drive ramps
      OutfeedCount : DInt;      // outfeed.count (PLC reads) cartons this remover has taken off the line, running total
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 10..100 % (starts at 60)
      ScannerCode : DInt;       // scanner.code (PLC reads) last code read, held until the next: 101 short, 102 tall, 201 metal
      AtstationDetect : Bool;   // atstation.detect (PLC reads) TRUE while a carton is in the beam
      GantryFault : Bool;       // gantry.fault (PLC reads) drive fault: TRUE = faulted
      GantryHolding : Bool;     // gantry.holding (PLC reads) the vacuum really has a carton (not just: grip is on)
      GantryInposition : Bool;  // gantry.inposition (PLC reads) within 1.5 % of the target it holds NOW -- stale on the scan you change the target
      GantryLowered : Bool;     // gantry.lowered (PLC reads) cup fully down
      GantryRaised : Bool;      // gantry.raised (PLC reads) cup fully up
      InfeedFault : Bool;       // infeed.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      PickstationFault : Bool;  // pickstation.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      ScannerPresent : Bool;    // scanner.present (PLC reads) TRUE while a carton is under the reader
      ScannerRead : Bool;       // scanner.read (PLC reads) TRUE for 0.2 s on each new read, as `code` changes -- latch the code on the rising edge
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "PickAndPlaceCell"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Pick & place cell (scene pick-and-place-cell)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Sequence three motions against feedback, not timers. Ramp the infeed
//   drive, read each carton's code at the scanner, then travel , lower ,
//   grip , raise , travel , release to put it on the outfeed. The gantry
//   reports whether the vacuum actually caught anything.
//
// DONE WHEN
//   Every carton fed reaches the outfeed, and gantry.holding is true on
//   every carry -- a cycle that runs with holding false carried air.
//   Careful with inposition: a target written this scan does not reach the
//   machine until the next one, so on the scan that issues a move it still
//   reports the place you are trying to leave. The mushroom (panel.estop,
//   normally closed) stops the infeed, the pick station and the gantry's
//   travel, without letting go of what the cup holds, within 200 ms and
//   its trip latches: releasing it restarts nothing, and neither does
//   Start or Reset alone -- only Reset, then Start.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".GantryTarget. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
