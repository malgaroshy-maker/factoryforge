DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      ConveyorRotate : Bool;   // conveyor.rotate (PLC writes) run the belt
      EmitterEmit : Bool;      // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      PanelGreen : Bool;       // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;         // panel.red (PLC writes) red lamp on the panel
      PusherExtend : Bool;     // pusher.extend (PLC writes) extend the pusher
      StackLightGreen : Bool;  // stack_light.green (PLC writes) green tower lamp
      CounterShort : DInt;     // counter.short (PLC reads) cartons that reached the end of the belt, running total
      CounterTall : DInt;      // counter.tall (PLC reads) cartons that came down the chute, running total
      PanelSetpoint : Real;    // panel.setpoint (PLC reads) the operator's pot, 0.3..1.8 s (starts at 0.9)
      ConveyorFault : Bool;    // conveyor.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      PanelEstop : Bool;       // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;       // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;       // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;        // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      PusherExtended : Bool;   // pusher.extended (PLC reads) pusher fully out
      PusherFault : Bool;      // pusher.fault (PLC reads) drive fault: TRUE = jammed; it freezes where it is
      PusherRetracted : Bool;  // pusher.retracted (PLC reads) pusher fully back
      SensorHighDetect : Bool; // sensor_high.detect (PLC reads) high beam: TRUE while a TALL carton is in it
      SensorLowDetect : Bool;  // sensor_low.detect (PLC reads) low beam: TRUE while any carton is in it
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "SortingByHeight"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Sorting by height (scene sorting-by-height)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Run the belt, feed cartons, and push the tall ones down the chute
//   while the short ones carry on. Two sensors at two heights are all you
//   get: a carton that breaks the high beam is tall, one that breaks only
//   the low beam is short.
//
// DONE WHEN
//   Every tall carton ends up in the chute and every short one at the far
//   end, with counter.tall and counter.short adding up to what you fed.
//   The mushroom stops the line inside 200 ms and Start alone will not
//   restart it. If the belt's drive faults (conveyor.fault), stop feeding,
//   and when the fault clears stay stopped until Reset, then Start.
//
// NOTE: This FF_IO has nineteen members, for the line the 3D engine opens
// and the grader marks. examples/tia/Sorting.scl is a finished program for
// the older ten-member FF_IO in examples/tia/FF_IO_datablock.md; the two
// DBs are not the same layout, so use one or the other.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".ConveyorRotate. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
