DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      CurrentGaugeValue : Real; // current_gauge.value (PLC writes) needle position, scale 0..120 A
      MotorDelta : Bool;        // motor.delta (PLC writes) delta contactor coil -- NEVER with star: together they short the supply
      MotorMain : Bool;         // motor.main (PLC writes) main contactor coil: feeds the motor windings
      MotorStar : Bool;         // motor.star (PLC writes) star contactor coil: ties the winding ends together (a third of the torque)
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      MotorCurrent : Real;      // motor.current (PLC reads) line current, A (full load 20 A)
      MotorSpeed : Real;        // motor.speed (PLC reads) motor speed, % of synchronous
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 50..95 % (starts at 85)
      MotorBreaker : Bool;      // motor.breaker (PLC reads) motor breaker, normally closed: TRUE = closed; trips on a star-delta short and stays tripped
      MotorDeltaaux : Bool;     // motor.deltaaux (PLC reads) delta contacts conducting
      MotorMainaux : Bool;      // motor.mainaux (PLC reads) main contacts conducting
      MotorOverload : Bool;     // motor.overload (PLC reads) thermal overload, normally closed: TRUE = OK, FALSE = tripped
      MotorStaraux : Bool;      // motor.staraux (PLC reads) star contacts conducting -- still TRUE for 45 ms after its coil drops
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "StarDeltaStart"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Star-delta starter (scene star-delta-start)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Start the motor in star -- main and star contactors -- change over to
//   delta when motor.speed reaches the speed on the panel's pot, and drop
//   everything on Stop. The changeover timing is yours: there is no timer
//   in the starter. Star and delta closed together is a short circuit, and
//   contacts close in 30 ms but take 45 ms to stop conducting, so wait for
//   motor.staraux to fall before you energise delta.
//
// DONE WHEN
//   The motor runs up in star, changes over at the pot's speed with a
//   modest current step, and runs on in delta, and motor.breaker never
//   drops. Drop star and energise delta in the same scan and the breaker
//   trips, and stays tripped until somebody closes it by hand at the
//   starter. Then load the machine (the starter's Motor Load) and start
//   again: the star run-up takes about twice as long, so a changeover
//   timed in seconds comes half way up it and draws nearly the direct-on-
//   line current. Only motor.speed knows when the motor is ready.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".CurrentGaugeValue. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
