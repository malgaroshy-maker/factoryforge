DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      BufferSpeed : Real;       // buffer.speed (PLC writes) speed reference, 0..100 % of 0.5 m/s; the drive ramps towards it
      CountDisplayValue : DInt; // count_display.value (PLC writes) number shown on the display ()
      BufferRun : Bool;         // buffer.run (PLC writes) run the drive
      EmitterEmit : Bool;       // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      EncReset : Bool;          // enc.reset (PLC writes) a LEVEL: held TRUE keeps the count at zero
      OutfeedRotate : Bool;     // outfeed.rotate (PLC writes) run the belt
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      StopRaise : Bool;         // stop.raise (PLC writes) raise the blade into the lane (holds cartons on a running belt)
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      BufferActual : Real;      // buffer.actual (PLC reads) actual speed, % -- lags the reference while the drive ramps
      EncCount : DInt;          // enc.count (PLC reads) measuring wheel pulses, 100 per metre of belt travel
      EncRate : Real;           // enc.rate (PLC reads) pulse rate, pulses/s
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 40..300 p (starts at 120)
      ReleasedCount : DInt;     // released.count (PLC reads) cartons this remover has taken off the line, running total
      BufferFault : Bool;       // buffer.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn
      ExitEyeDetect : Bool;     // exit_eye.detect (PLC reads) TRUE while a carton is in the beam
      OutfeedFault : Bool;      // outfeed.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      StopDown : Bool;          // stop.down (PLC reads) blade fully down
      StopFault : Bool;         // stop.fault (PLC reads) drive fault: TRUE = faulted; the blade stays where it is
      StopUp : Bool;            // stop.up (PLC reads) blade fully up
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "AccumulationBuffer"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Accumulation buffer (scene accumulation-buffer)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Let cartons pile up behind the blade stop on a belt that never stops,
//   then release a batch. Time the release by encoder pulses rather than
//   by seconds: the pot is a release window in pulses, which is a
//   distance.
//
// DONE WHEN
//   Nothing gets past a raised blade while the belt keeps running, and the
//   same pulse window releases the same amount of product at any drive
//   speed -- turn buffer.speed up and the release takes half as long and
//   lets out the same number. A timer would have let out twice as many.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".BufferSpeed. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
