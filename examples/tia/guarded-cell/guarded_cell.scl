DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      CylinderExtend : Bool;    // cylinder.extend (PLC writes) extend coil (5/2 valve, no spring: the rod stays where it was last driven)
      CylinderRetract : Bool;   // cylinder.retract (PLC writes) retract coil
      EmitterEmit : Bool;       // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll
      GuardALock : Bool;        // guard_a.lock (PLC writes) energise the solenoid lock (it only bites on a shut door)
      GuardBLock : Bool;        // guard_b.lock (PLC writes) energise the solenoid lock (it only bites on a shut door)
      PanelGreen : Bool;        // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;          // panel.red (PLC writes) red lamp on the panel
      RelayReset : Bool;        // relay.reset (PLC writes) reset: the relay closes on a RISING edge, and only with both channels healthy
      ScannerMute : Bool;       // scanner.mute (PLC writes) request muting; honoured for at most 6 s at a stretch
      StarterCoil : Bool;       // starter.coil (PLC writes) contactor coil -- the contactor runs belt.rotate
      TowerGreen : Bool;        // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;          // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;       // tower.yellow (PLC writes) tower lamp, yellow
      LineEndCount : DInt;      // line_end.count (PLC reads) cartons this remover has taken off the line, running total
      PanelSetpoint : Real;     // panel.setpoint (PLC reads) the operator's pot, 1..10 s (starts at 3.5)
      StarterCurrent : Real;    // starter.current (PLC reads) motor current, A
      TransferredCount : DInt;  // transferred.count (PLC reads) cartons this remover has taken off the line, running total
      BeltFault : Bool;         // belt.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn, whatever it is told
      CylinderExtended : Bool;  // cylinder.extended (PLC reads) reed switch at full stroke
      CylinderFault : Bool;     // cylinder.fault (PLC reads) TRUE = the cylinder has seized
      CylinderRetracted : Bool; // cylinder.retracted (PLC reads) reed switch at home; mid-stroke neither reed is made
      GuardAClosed : Bool;      // guard_a.closed (PLC reads) guard switch, normally closed: TRUE while the door is shut
      GuardALocked : Bool;      // guard_a.locked (PLC reads) TRUE while the door is locked shut
      GuardBClosed : Bool;      // guard_b.closed (PLC reads) guard switch, normally closed: TRUE while the door is shut
      GuardBLocked : Bool;      // guard_b.locked (PLC reads) TRUE while the door is locked shut
      MuteEyeDetect : Bool;     // mute_eye.detect (PLC reads) TRUE while a carton is in the beam
      PanelEstop : Bool;        // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;        // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;        // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;         // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      PushEyeDetect : Bool;     // push_eye.detect (PLC reads) TRUE while a carton is in the beam
      RelayCha : Bool;          // relay.cha (PLC reads) channel A as the relay sees it (guard_a.closed)
      RelayChb : Bool;          // relay.chb (PLC reads) channel B as the relay sees it (guard_b.closed)
      RelayFault : Bool;        // relay.fault (PLC reads) TRUE = the two channels disagreed; the relay latches this fault
      RelayK1 : Bool;           // relay.k1 (PLC reads) safety contact K1: TRUE while the relay's outputs are closed (open, they hold starter.coil FALSE)
      RelayK2 : Bool;           // relay.k2 (PLC reads) safety contact K2: TRUE while the relay's outputs are closed
      ScannerMuted : Bool;      // scanner.muted (PLC reads) TRUE while muting is actually in force
      ScannerStop : Bool;       // scanner.stop (PLC reads) protective field clear, normally closed: TRUE = clear, FALSE = someone is in it
      ScannerWarn : Bool;       // scanner.warn (PLC reads) TRUE while the warning field is broken
      StarterAux : Bool;        // starter.aux (PLC reads) auxiliary contact: TRUE while the contactor has really pulled in
      StarterOverload : Bool;   // starter.overload (PLC reads) thermal overload, normally closed: TRUE = OK, FALSE = tripped
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "GuardedCell"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Guarded cell (scene guarded-cell)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Run the transfer cell without ever writing belt.rotate. You command
//   starter.coil; the contactor runs the motor. The safety relay watches
//   one interlock contact from each leaf of the cell gate and holds your
//   coil off until both leaves are shut and somebody presses Reset -- so
//   the relay closing hands the coil back and starts nothing. Cartons have
//   to cross the scanner's protective field, so bridge it with
//   scanner.mute while each one passes; the panel's pot is how long you
//   bridge it for. Then transfer each carton into the chute with the
//   cylinder, sequencing on the two reeds and never energising both coils.
//
// DONE WHEN
//   Cartons reach transferred.count while your program has never written
//   belt.rotate -- belt.rotate follows starter.aux, because the contactor
//   runs the motor and you only run the coil. Opening either gate leaf
//   stops the cell inside 200 ms; closing both and pressing Reset lights
//   relay.k1 and starts nothing at all, and Start is what starts it. Open
//   one leaf on its own and, past the relay's sync window, relay.fault
//   latches: a reset while it is still open will not clear it. Finally
//   turn the pot past the scanner's own mute limit and watch scanner.muted
//   go out while scanner.mute is still commanded -- your mute stopped being
//   a mute, the next carton in the field stopped the cell, and that is
//   what a mute without a limit hides.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".CylinderExtend. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
//
// NOT IN FF_IO
//   belt.rotate: starter.coil's contactor drives it; a program that writes
//   it fails this exercise. It has no member and no mapping, so nothing
//   the PLC does can write it.
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
