DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      AxisTarget : Real;           // axis.target (PLC writes) target position, mm, 0..1000
      AxisVelocity : Real;         // axis.velocity (PLC writes) move velocity, mm/s (the axis caps it at 500)
      PositionDisplayValue : DInt; // position_display.value (PLC writes) number shown on the display (mm)
      AxisAck : Bool;              // axis.ack (PLC writes) acknowledge a latched error: RISING edge, and only once its cause has gone
      AxisEnable : Bool;           // axis.enable (PLC writes) power the drive (a level, like MC_Power.Enable)
      PanelGreen : Bool;           // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;             // panel.red (PLC writes) red lamp on the panel
      TowerGreen : Bool;           // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;             // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;          // tower.yellow (PLC writes) tower lamp, yellow
      AxisPosition : Real;         // axis.position (PLC reads) actual position, mm
      PanelSetpoint : Real;        // panel.setpoint (PLC reads) the operator's pot, 300..950 mm (starts at 800)
      AxisError : Bool;            // axis.error (PLC reads) latched drive error: the axis has stopped itself and waits for an acknowledge
      AxisFault : Bool;            // axis.fault (PLC reads) drive fault present: TRUE = the cause of an error is still there
      AxisInposition : Bool;       // axis.inposition (PLC reads) stopped within 0.5 mm of the target it holds NOW -- stale on the scan you change the target
      AxisReady : Bool;            // axis.ready (PLC reads) powered and error-free
      PanelEstop : Bool;           // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;           // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;           // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;            // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "ServoPositioning"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Servo positioning (scene servo-positioning)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Shuttle the axis between station A at 100 mm and station B, the
//   panel's pot, dwelling a second at each, from Start until Stop. The
//   drive does nothing until axis.enable has been on long enough for
//   axis.ready, and every move needs axis.velocity as well as axis.target.
//   When the drive faults it stops itself and latches axis.error: hold
//   your sequence, show it, and acknowledge -- a rising edge of axis.ack
//   -- only when the operator presses Reset and axis.fault has gone.
//
// DONE WHEN
//   The carriage stops on A and on B in turn, and on the new B as soon as
//   you turn the pot. Raise axis.fault mid-move and the carriage quick-
//   stops; clear it, and nothing moves until somebody presses Reset -- a
//   program that acknowledges on its own is automatic restart by another
//   name. Careful with inposition: on the scan that writes a new target it
//   still describes the old one, so arrive on axis.position against the
//   station you are going to. The mushroom (panel.estop, normally closed)
//   stops the axis within 200 ms and its trip latches: releasing it
//   restarts nothing, and neither does Start or Reset alone -- only Reset,
//   then Start.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".AxisTarget. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
