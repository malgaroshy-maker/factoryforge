DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      WeightReadoutValue : DInt; // weight_readout.value (PLC writes) number shown on the display (g)
      EmitterEmit : Bool;        // emitter.emit (PLC writes) rising edge = feed one carton; hold each level well over one poll; every 3rd carton is steel
      InfeedRotate : Bool;       // infeed.rotate (PLC writes) run the roller deck
      PanelGreen : Bool;         // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;           // panel.red (PLC writes) red lamp on the panel
      ScaleRotate : Bool;        // scale.rotate (PLC writes) run the weighing belt
      OutfeedCount : DInt;       // outfeed.count (PLC reads) cartons this remover has taken off the line, running total
      PanelSetpoint : Real;      // panel.setpoint (PLC reads) the operator's pot, 0..6000 g (starts at 3000)
      ScaleWeight : DInt;        // scale.weight (PLC reads) load cell: grams on the deck right now (everything on it, not one carton)
      InfeedFault : Bool;        // infeed.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn
      MetalCheckDetect : Bool;   // metal_check.detect (PLC reads) TRUE while a METAL carton is in front of it; cardboard is invisible to it
      PanelEstop : Bool;         // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;         // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;         // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;          // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      ScaleFault : Bool;         // scale.fault (PLC reads) drive fault: TRUE = faulted; a faulted drive does not turn
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "RollerLineWeighing"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Roller line with weighing (scene roller-line-weighing)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Checkweigh. Judge each carton on the peak weight it shows as it
//   crosses the deck, and reject anything over the limit on the panel's
//   pot. The inductive sensor sees metal only, and on this line the steel
//   cartons are also the heavy ones -- so two independent instruments
//   should agree.
//
// DONE WHEN
//   The cartons you flag over-limit are the same ones the inductive sensor
//   flags as metal. Watch the spacing: two cartons on the deck at once
//   read as one peak, so a real checkweigher line holds the feed while the
//   scale is loaded.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".WeightReadoutValue. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
