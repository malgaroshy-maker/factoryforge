DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      OvenHeater : Real;       // oven.heater (PLC writes) heater power, 0..100 %
      TempGaugeValue : Real;   // temp_gauge.value (PLC writes) needle position, scale 0..300 C
      TempReadoutValue : DInt; // temp_readout.value (PLC writes) number shown on the display (C)
      AlarmBeacon : Bool;      // alarm.beacon (PLC writes) rotating alarm beacon
      AlarmHorn : Bool;        // alarm.horn (PLC writes) alarm horn
      PanelGreen : Bool;       // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;         // panel.red (PLC writes) red lamp on the panel
      TowerGreen : Bool;       // tower.green (PLC writes) tower lamp, green
      TowerRed : Bool;         // tower.red (PLC writes) tower lamp, red
      TowerYellow : Bool;      // tower.yellow (PLC writes) tower lamp, yellow
      OvenTemperature : Real;  // oven.temperature (PLC reads) plate temperature, degC
      PanelSetpoint : Real;    // panel.setpoint (PLC reads) the operator's pot, 20..280 C (starts at 180)
      OvenAttemp : Bool;       // oven.attemp (PLC reads) within +/-3 degC of the station's own 180 degC -- not the pot
      OvenFault : Bool;        // oven.fault (PLC reads) element failed: TRUE = it takes your command and heats nothing
      PanelEstop : Bool;       // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;       // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;       // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;        // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "HeatTreatStation"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Heat treat station (scene heat-treat-station)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   Hold the plate at the temperature on the panel's pot. The plant is a
//   first-order lag with a loss to ambient, so holding a temperature needs
//   a standing output -- and proportional control can only make one out of
//   a standing error.
//
// DONE WHEN
//   With proportional gain alone the plate parks visibly short of setpoint
//   -- measure that offset. Add integral action and it closes. Then fail
//   the element (oven.fault) and watch oven.heater keep reading what you
//   commanded while the temperature falls: the output tells you nothing,
//   only the measurement does. Light alarm.beacon within five seconds of
//   the failure and keep it lit -- and never while the element is healthy.
//   The mushroom (panel.estop, normally closed) cuts the heater within 200
//   ms and its trip latches: releasing it restarts nothing, and neither
//   does Start or Reset alone -- only Reset, then Start.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".OvenHeater. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
