DATA_BLOCK "FF_IO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      PressureGaugeValue : Real; // pressure_gauge.value (PLC writes) needle position, scale 0..10 bar
      AlarmBeacon : Bool;        // alarm.beacon (PLC writes) rotating alarm beacon
      AlarmHorn : Bool;          // alarm.horn (PLC writes) alarm horn
      PanelGreen : Bool;         // panel.green (PLC writes) green lamp on the panel
      PanelRed : Bool;           // panel.red (PLC writes) red lamp on the panel
      ReceiverSupply : Bool;     // receiver.supply (PLC writes) open the receiver's supply valve (load the receiver)
      ValveOpen : Bool;          // valve.open (PLC writes) energise the solenoid: the valve travels open (spring closes it when dropped)
      PanelSetpoint : Real;      // panel.setpoint (PLC reads) the operator's pot, 4..6.5 bar (starts at 6)
      ReceiverPressure : DInt;   // receiver.pressure (PLC reads) receiver pressure, RAW counts: 0 = 0 bar, 27648 = 10 bar, 32767 = wire break
      PanelEstop : Bool;         // panel.estop (PLC reads) E-stop, normally closed: TRUE = healthy, FALSE = pressed; stays pressed until pulled out
      PanelReset : Bool;         // panel.reset (PLC reads) Reset button, momentary: a short pulse per press
      PanelStart : Bool;         // panel.start (PLC reads) Start button, momentary: a short pulse per press -- latch it
      PanelStop : Bool;          // panel.stop (PLC reads) Stop button, momentary: a short pulse per press
      ReceiverWirebreak : Bool;  // receiver.wirebreak (PLC reads) the card's wire-break diagnostic for the 4-20 mA loop
      ValveClosed : Bool;        // valve.closed (PLC reads) limit switch: valve fully closed; mid-travel neither is made (2 s end to end)
      ValveFault : Bool;         // valve.fault (PLC reads) TRUE = the stem has seized; the feedback no longer follows the command
      ValveOpened : Bool;        // valve.opened (PLC reads) limit switch: valve fully open
   END_VAR


BEGIN

END_DATA_BLOCK


FUNCTION_BLOCK "AirReceiver"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

// ---------------------------------------------------------------------------
// FactoryForge starter -- Air receiver (scene air-receiver)
// Generated by tools/gen_starters.py; see README.md beside this file.
//
// THE TASK
//   While the station runs, keep the receiver between the pot less 0.5 bar
//   and the pot: open receiver.supply at the bottom of the band, close it
//   at the top. receiver.pressure is the card's raw count -- 0 at 4 mA,
//   27648 at 20 mA, over 0..10 bar -- so scale it (NORM_X, then SCALE_X)
//   and show bar on the gauge. Open the isolation valve while the station
//   runs and prove it by valve.opened: it takes 2 s to travel, and if it
//   has not arrived when that and a margin have run out, it has failed --
//   alarm, and stop.
//
// DONE WHEN
//   The needle on the receiver's own gauge and the one you drive agree,
//   and the receiver cycles inside the band -- still after the plant draws
//   harder (the receiver's Consumption) and after you move the pot. Divide
//   by 32767 instead of 27648 and everything reads 16 % low and the
//   receiver runs 16 % high. Seize the valve (valve.fault) and Start:
//   valve.opened never comes, and only a timer on the feedback notices --
//   but a check without one alarms on every healthy start, because for two
//   seconds neither limit switch is made.
//
// Every signal is a member of the global DB "FF_IO" above: read and write
// them as "FF_IO".<Name>, e.g. "FF_IO".PressureGaugeValue. Its comments say which
// way each one runs. Call this block from OB1 (drag it into Main; TIA creates
// the instance DB).
// ---------------------------------------------------------------------------

BEGIN

    // Your program.

END_FUNCTION_BLOCK
