[
  {
    "id": "ff-tab",
    "type": "tab",
    "label": "FactoryForge",
    "disabled": false,
    "info": "Drives the FactoryForge sorting scene over OPC UA.\n\nStart the simulator first, in the folder FactoryForge was extracted to:\n\n    .\\factoryforge-sidecar demo --driver opcua-server\n\n(./factoryforge-sidecar on Linux.)\n\nThen deploy this flow. Node-RED takes the place of the PLC: it runs the belt,\npulses the emitter, and fires the pusher when the high sensor sees a tall box."
  },
  {
    "id": "ff-endpoint",
    "type": "OpcUa-Endpoint",
    "endpoint": "opc.tcp://127.0.0.1:4841/factoryforge/",
    "secpol": "None",
    "secmode": "None",
    "none": true,
    "login": false,
    "usercert": false,
    "usercertificate": "",
    "userprivatekey": "",
    "name": "FactoryForge sim"
  },

  {
    "id": "ff-start",
    "type": "inject",
    "z": "ff-tab",
    "name": "start belt",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "true",
    "payloadType": "bool",
    "x": 140,
    "y": 80,
    "wires": [["ff-item-conveyor"]]
  },
  {
    "id": "ff-item-conveyor",
    "type": "OpcUa-Item",
    "z": "ff-tab",
    "item": "ns=2;s=conveyor.rotate",
    "datatype": "Boolean",
    "value": "",
    "name": "conveyor.rotate",
    "x": 380,
    "y": 80,
    "wires": [["ff-write"]]
  },

  {
    "id": "ff-emit-tick",
    "type": "inject",
    "z": "ff-tab",
    "name": "every 1.5s",
    "props": [{ "p": "payload" }],
    "repeat": "1.5",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 140,
    "y": 160,
    "wires": [["ff-toggle"]]
  },
  {
    "id": "ff-toggle",
    "type": "function",
    "z": "ff-tab",
    "name": "toggle emit flag",
    "func": "// Square wave, exactly like Sorting.scl. One box per rising edge.\n// A level held for 1.5s cannot be missed by any sampling rate.\nlet flag = flow.get('emitFlag') || false;\nflag = !flag;\nflow.set('emitFlag', flag);\nmsg.payload = flag;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 160,
    "wires": [["ff-item-emitter"]]
  },
  {
    "id": "ff-item-emitter",
    "type": "OpcUa-Item",
    "z": "ff-tab",
    "item": "ns=2;s=emitter.emit",
    "datatype": "Boolean",
    "value": "",
    "name": "emitter.emit",
    "x": 620,
    "y": 160,
    "wires": [["ff-write"]]
  },

  {
    "id": "ff-item-sensorhigh",
    "type": "OpcUa-Item",
    "z": "ff-tab",
    "item": "ns=2;s=sensor_high.detect",
    "datatype": "Boolean",
    "value": "",
    "name": "sensor_high.detect",
    "x": 160,
    "y": 260,
    "wires": [["ff-subscribe"]]
  },
  {
    "id": "ff-sub-tick",
    "type": "inject",
    "z": "ff-tab",
    "name": "subscribe on start",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 320,
    "wires": [["ff-item-sensorhigh"]]
  },
  {
    "id": "ff-subscribe",
    "type": "OpcUa-Client",
    "z": "ff-tab",
    "endpoint": "ff-endpoint",
    "action": "subscribe",
    "deadbandtype": "a",
    "deadbandvalue": 1,
    "time": "50",
    "timeUnit": "ms",
    "certificate": "n",
    "localfile": "",
    "localkeyfile": "",
    "securitymode": "None",
    "securitypolicy": "None",
    "useTransport": false,
    "maxChunkCount": "",
    "maxMessageSize": "",
    "receiveBufferSize": "",
    "sendBufferSize": "",
    "setstatusandtime": false,
    "keepsessionalive": true,
    "name": "subscribe sensor_high",
    "x": 440,
    "y": 260,
    "wires": [["ff-rising-edge"]]
  },
  {
    "id": "ff-rising-edge",
    "type": "function",
    "z": "ff-tab",
    "name": "rising edge",
    "func": "// Only act when the sensor goes false -> true. The box clears the sensor\n// long before it reaches the pusher, so the request must outlive the signal.\nconst now = msg.payload === true || msg.payload === 'true';\nconst prev = flow.get('highMem') || false;\nflow.set('highMem', now);\nif (now && !prev) {\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 660,
    "y": 260,
    "wires": [["ff-delay"]]
  },
  {
    "id": "ff-delay",
    "type": "delay",
    "z": "ff-tab",
    "name": "900ms travel",
    "pauseType": "delay",
    "timeout": "900",
    "timeoutUnits": "milliseconds",
    "rate": "1",
    "nbRateUnits": "1",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": false,
    "allowrate": false,
    "outputs": 1,
    "x": 840,
    "y": 260,
    "wires": [["ff-stroke"]]
  },
  {
    "id": "ff-stroke",
    "type": "trigger",
    "z": "ff-tab",
    "name": "extend 500ms",
    "op1": "true",
    "op2": "false",
    "op1type": "bool",
    "op2type": "bool",
    "duration": "500",
    "extend": false,
    "overrideDelay": false,
    "units": "ms",
    "reset": "",
    "bytopic": "all",
    "topic": "topic",
    "outputs": 1,
    "x": 1020,
    "y": 260,
    "wires": [["ff-item-pusher"]]
  },
  {
    "id": "ff-item-pusher",
    "type": "OpcUa-Item",
    "z": "ff-tab",
    "item": "ns=2;s=pusher.extend",
    "datatype": "Boolean",
    "value": "",
    "name": "pusher.extend",
    "x": 1200,
    "y": 260,
    "wires": [["ff-write"]]
  },

