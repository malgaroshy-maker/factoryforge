; FactoryForge engine — Godot 4.7 / C#
; See ../docs/PLAN.md

config_version=5

[application]

config/name="FactoryForge"
config/description="Free, open 3D factory simulator for learning PLC programming. Developed by Mahamed Algaroshy."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.09, 0.102, 0.125, 1)

[display]

; Godot's own default (1152x648) is what clipped the start screen's 980x640
; card and ran the parts palette off the bottom of the window (FF-17, FF-18).
; canvas_items stretch keeps 2D UI legible if the window is later resized on
; a high-DPI display, which was previously unhandled entirely.
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; The scene is nothing but hard-edged machinery -- rails, posts, belt frames,
; the light curtain's twelve beams -- and every one of those edges was
; aliasing. 4x MSAA is the single largest change to how sharp this looks, and
; it costs a Forward+ desktop renderer very little on geometry this simple.
; FXAA is left off deliberately: it would soften the 3D readouts (the tank's
; level, the weigh conveyor's grams, the drive's percentage) which are Label3D
; text and need to stay crisp.
anti_aliasing/quality/msaa_3d=2

[dotnet]

project/assembly_name="FactoryForge"

[physics]

3d/physics_engine="Jolt Physics"
