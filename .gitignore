# FactoryForge .gitignore

# Godot engine build outputs & mono temp files
.godot/
engine/.godot/
*.import

# .NET build outputs
bin/
obj/
*.user
*.suo
*.userosset
*.sln.docstates

# Python bytecode & caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
*.egg-info/
build/
dist/

# Temporary screenshots & logs. Working screenshots land in the repo root and
# are throwaway; anything under docs/images/ is documentation and belongs in
# the repo, so it is exempted rather than force-added case by case.
#
# engine/icon.png is exempted too -- it is the actual app icon referenced by
# project.godot and both export presets (FF-31), not a throwaway screenshot.
# Without this line it would match *.png, never get committed, and every
# clone but this one would export with a missing icon -- the exact shape of
# bug FF-30 already found once with a different ignored file.
#
# engine/assets/ is shipped art (the logo, the splash; ASSETS.md records each
# file). The first commit of the logo matched *.png and left it out, and the
# splash with it (V12-06); test_plan A8 now fails on an ignored asset.
*.png
!docs/images/**/*.png
!engine/icon.png
!engine/assets/**/*.png
*.log
scratch/

# test_plan.py engine output
.test_plan_engine.log

# Godot rewrites the csproj SDK version on first open and leaves a backup.
*.csproj.old
